static SemaphoreHandle_t s_draw_done_sem = NULL;

// Callback ทำงานเมื่อ DMA2D ส่งภาพเฟรมก่อนหน้าเสร็จเรียบร้อย
static bool on_color_trans_done_cb(esp_lcd_panel_handle_t panel, 
                                   esp_lcd_dpi_panel_event_data_t *edata, 
                                   void *user_ctx)
{
    BaseType_t need_yield = pdFALSE;
    xSemaphoreGiveFromISR(s_draw_done_sem, &need_yield);
    return (need_yield == pdTRUE);
}

static bool is_jpeg_file(const char *filename)
{
    const char *dot = strrchr(filename, '.');
    if (!dot) return false;
    return (strcasecmp(dot, ".jpg") == 0 || strcasecmp(dot, ".jpeg") == 0);
}

static void bsp_enable_speaker_pa(void) {
    gpio_config_t io_conf = {
        .pin_bit_mask = (1ULL << PA_ENABLE_GPIO),
        .mode = GPIO_MODE_OUTPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
    };
    gpio_config(&io_conf);
    gpio_set_level(PA_ENABLE_GPIO, 1); // สั่ง High เพื่อเปิดวงจรขยายเสียง
}

static RingbufHandle_t s_audio_ringbuf = NULL;
static i2s_chan_handle_t s_i2s_tx_chan = NULL;

#define AUDIO_ACCUM_BUF_SIZE (8 * 1024)

static void avi_audio_stream_task(void *pvParam) {
    HMP3Decoder mp3_dec = MP3InitDecoder();
    // จองสำหรับรองรับ Stereo สูงสุด 1152 * 2 samples
    int16_t *pcm_out = (int16_t *)malloc(1152 * 2 * sizeof(int16_t));
    MP3FrameInfo frame_info;

    s_i2s_tx_chan = mp3.i2s_hnd;

    // บัฟเฟอร์สะสมข้อมูลดิบ MP3 เพื่อไม่ให้เศษเฟรมหลุดหาย
    uint8_t *accum_buf = (uint8_t *)malloc(AUDIO_ACCUM_BUF_SIZE);
    int accum_bytes = 0;
    uint32_t current_sample_rate = 0;

    while (1) {
        size_t item_size = 0;
        // รอรับ Chunk จาก RingBuffer
        uint8_t *chunk = (uint8_t *)xRingbufferReceive(s_audio_ringbuf, &item_size, portMAX_DELAY);
        if (!chunk) continue;

        // 1. นำข้อมูล Chunk ใหม่มาต่อท้ายเศษไบต์เดิมที่ยังถอดรหัสไม่หมด
        if (accum_bytes + item_size <= AUDIO_ACCUM_BUF_SIZE) {
            memcpy(accum_buf + accum_bytes, chunk, item_size);
            accum_bytes += item_size;
        } else {
            // ป้องกัน Overflow หากสะสมมากเกินไป
            accum_bytes = 0;
        }
        vRingbufferReturnItem(s_audio_ringbuf, (void *)chunk);

        int bytes_left = accum_bytes;
        unsigned char *read_ptr = accum_buf;

        // 2. ถอดรหัสข้อมูลที่มีอยู่ทั้งหมด
        while (bytes_left > 0) {
            int offset = MP3FindSyncWord(read_ptr, bytes_left);
            if (offset < 0) {
                // ไม่พบ Sync Word ในข้อมูลที่เหลือ ให้ล้างทิ้ง
                bytes_left = 0;
                break;
            }

            read_ptr += offset;
            bytes_left -= offset;

            int err = MP3Decode(mp3_dec, &read_ptr, &bytes_left, pcm_out, 0);
            
            if (err == ERR_MP3_NONE) {
                MP3GetLastFrameInfo(mp3_dec, &frame_info);

                // ตรวจสอบและอัปเดต Sample Rate ให้ตรงกับไฟล์เสียงจริงแบบไดนามิก
                if (frame_info.samprate > 0 && frame_info.samprate != current_sample_rate) {
                    current_sample_rate = frame_info.samprate;
                    i2s_std_clk_config_t clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(current_sample_rate);
                    clk_cfg.mclk_multiple = I2S_MCLK_MULTIPLE_256;
                    i2s_channel_disable(s_i2s_tx_chan);
                    i2s_channel_reconfig_std_clock(s_i2s_tx_chan, &clk_cfg);
                    i2s_channel_enable(s_i2s_tx_chan);
                    ESP_LOGI(TAG, "Audio sample rate locked at %lu Hz", (unsigned long)current_sample_rate);
                }

                size_t pcm_bytes = 0;

                // ตรวจสอบกรณีเสียงเป็น Mono (1 Ch) ให้คัดลอกลง 2 แชนแนลสำหรับ I2S Stereo
                if (frame_info.nChans == 1) {
                    for (int i = frame_info.outputSamps - 1; i >= 0; i--) {
                        pcm_out[i * 2]     = pcm_out[i];
                        pcm_out[i * 2 + 1] = pcm_out[i];
                    }
                    pcm_bytes = frame_info.outputSamps * 2 * sizeof(int16_t);
                } else {
                    pcm_bytes = frame_info.outputSamps * sizeof(int16_t);
                }

                size_t written = 0;
                i2s_channel_write(s_i2s_tx_chan, pcm_out, pcm_bytes, &written, portMAX_DELAY);
            } 
            else if (err == ERR_MP3_INDATA_UNDERFLOW) {
                // ข้อมูลไม่พอจบรอบเฟรม -> พักไว้ เพื่อรอข้อมูล Chunk ถัดไปมาเติม
                break;
            } 
            else {
                // ข้อมูลเสียหาย ให้เลื่อนข้าม 1 ไบต์เพื่อหา Sync ถัดไป
                if (bytes_left > 0) {
                    read_ptr++;
                    bytes_left--;
                }
            }
        }

        // 3. ย้ายเศษไบต์ที่เหลือจากการ Underflow กลับไปไว้ที่ต้นบัฟเฟอร์ (ห้ามทิ้งเด็ดขาด!)
        if (bytes_left > 0 && read_ptr != accum_buf) {
            memmove(accum_buf, read_ptr, bytes_left);
        }
        accum_bytes = bytes_left;
    }
}

// บัฟเฟอร์ Double Buffer 2 ชุดใน PSRAM (~2.3 MB)
static uint8_t *s_video_fb[2] = {NULL, NULL};
static int s_fb_idx = 0;

esp_err_t play_avi_video(esp_lcd_panel_handle_t panel, const char *avi_path)
{
    avilib_config_t cfg = {
        .buffer_size = 128 * 1024, // บัฟเฟอร์อ่านไฟล์ขยายเป็น 64 KB เพื่อรองรับแบนด์วิดท์ DDR50
        .use_psram   = true,
    };

    ESP_LOGI(TAG, "Opening AVI file: %s", avi_path);
    avi_t *avi = AVI_open_input_file_ex(avi_path, 0, &cfg);
    if (!avi) {
        ESP_LOGE(TAG, "Failed to open AVI: %s", AVI_strerror());
        return ESP_FAIL;
    }

    int v_width  = AVI_video_width(avi);
    int v_height = AVI_video_height(avi);
    double fps   = AVI_frame_rate(avi);
    long total_frames = AVI_video_frames(avi);

    ESP_LOGI(TAG, "Video: %dx%d @ %.2f FPS | Total Frames: %ld | Codec: %s",
             v_width, v_height, fps, total_frames, AVI_video_compressor(avi));

    // ตรวจสอบเงื่อนไขฮาร์ดแวร์ Decoder ของ P4
    if ((v_width * v_height % 8 != 0)) {
        ESP_LOGE(TAG, "AVI video dimensions must be divisible by 8!");
        AVI_close(avi);
        return ESP_ERR_NOT_SUPPORTED;
    }

    // 1. จัดเตรียมบัฟเฟอร์แสดงผลและบัฟเฟอร์รับข้อมูล Chunk
    size_t fb_size = (LCD_H_RES * LCD_V_RES * 2) + 18;
    for (int i = 0; i < 2; i++) {
        if (!s_video_fb[i]) {
            s_video_fb[i] = (uint8_t *)heap_caps_aligned_alloc(64, fb_size, MALLOC_CAP_SPIRAM);
            if (!s_video_fb[i]) {
                ESP_LOGE(TAG, "Alloc Double Buffer [%d] failed", i);
                AVI_close(avi);
                return ESP_ERR_NO_MEM;
            }
        }
    }

    long max_chunk = AVI_max_video_chunk(avi) + 4096;
    if (max_chunk < 128 * 1024) max_chunk = 128 * 1024;

    if (!s_audio_ringbuf) {
        s_audio_ringbuf = xRingbufferCreate(64 * 1024, RINGBUF_TYPE_NOSPLIT);
        xTaskCreate(avi_audio_stream_task, "avi_audio", 8192, NULL, 5, NULL);
    }

    // vbuf พักข้อมูล JPEG แต่ละเฟรม (จองใน Internal RAM เพื่อให้ DMA ดึงได้เร็วที่สุด)
    uint8_t *vbuf = (uint8_t *)heap_caps_aligned_alloc(64, max_chunk, MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA);
    if (!vbuf) {
        vbuf = (uint8_t *)heap_caps_aligned_alloc(64, max_chunk, MALLOC_CAP_SPIRAM);
    }
    char *abuf = (char *)malloc(4096);

    // 2. สร้าง Hardware JPEG Decoder Engine เพียงครั้งเดียว
    jpeg_decoder_handle_t jpeg_dec = NULL;
    jpeg_decode_engine_cfg_t eng_cfg = {
        .intr_priority = 0,
        .timeout_ms = 500,
    };
    ESP_ERROR_CHECK(jpeg_new_decoder_engine(&eng_cfg, &jpeg_dec));

    jpeg_decode_cfg_t dec_cfg = {
        .output_format = JPEG_DECODE_OUT_FORMAT_RGB565,
        .rgb_order = JPEG_DEC_RGB_ELEMENT_ORDER_BGR,
    };

    // คำนวณขอบเขตพิกัดกึ่งกลางจอ
    uint32_t aligned_w = (v_width + 15) & ~15;
    uint32_t aligned_h = (v_height + 15) & ~15;
    size_t out_pixel_bytes = aligned_w * aligned_h * 2;

    int x_start = (LCD_H_RES > aligned_w) ? (LCD_H_RES - aligned_w) / 2 : 0;
    int y_start = (LCD_V_RES > v_height) ? (LCD_V_RES - v_height) / 2 : 0;

    int64_t t_playback_start = esp_timer_get_time();

    int64_t frame_interval_us = (int64_t)(1000000.0 / fps);
    long chunk_len = 0;
    long decoded_frames = 0;
    
    // ตั้งจุดอ้างอิงเวลาเริ่มต้น
    int64_t next_frame_time = esp_timer_get_time();

    ESP_LOGI(TAG, "Starting playback...");

    // 3. วนลูปอ่านข้อมูลและถอดรหัสทีละเฟรม
    while (1) {
        int ret = AVI_read_data(avi, (char *)vbuf, max_chunk, abuf, 4096, &chunk_len);
        if (ret == 0) break;
        if (ret < 0) continue;

        if (ret == 1 && chunk_len > 4) { // Video Chunk
            size_t offset = 0;
            while (offset + 1 < (size_t)chunk_len) {
                if (vbuf[offset] == 0xFF && vbuf[offset + 1] == 0xD8) break;
                offset++;
            }

            if (offset + 1 < (size_t)chunk_len) {
                uint32_t out_bytes = 0;
                
                // ถอดรหัสลงในบัฟเฟอร์ชุดปัจจุบัน (s_fb_idx)
                esp_err_t err = jpeg_decoder_process(jpeg_dec, &dec_cfg, 
                                                     vbuf + offset, chunk_len - offset,
                                                     s_video_fb[s_fb_idx], out_pixel_bytes, &out_bytes);

                if (err == ESP_OK) {
                    // รอให้รอบก่อนหน้าส่ง DMA2D เสร็จ 100% ก่อนสั่งวาดใหม่ (Timeout 50ms)
                    if (xSemaphoreTake(s_draw_done_sem, pdMS_TO_TICKS(50)) == pdTRUE) {
                        esp_lcd_panel_draw_bitmap(panel, 
                                                  x_start, 
                                                  y_start, 
                                                  x_start + aligned_w, 
                                                  y_start + v_height, 
                                                  s_video_fb[s_fb_idx]);
                        
                        // สลับบัฟเฟอร์สำหรับเฟรมถัดไป (0 -> 1 -> 0)
                        s_fb_idx ^= 1;
                        decoded_frames++;
                    } else {
                        ESP_LOGW(TAG, "DMA2D busy timeout! Skipped frame sync");
                    }
                }
            }

            // จัดการหน่วงเวลาคุม FPS ตามเดิม
            next_frame_time += frame_interval_us;
            int64_t now = esp_timer_get_time();
            if (next_frame_time > now) {
                int64_t wait_ms = (next_frame_time - now) / 1000;
                if (wait_ms > 0) {
                    vTaskDelay(pdMS_TO_TICKS(wait_ms));
                }
            } else {
                next_frame_time = now;
            }
        } else if (ret == 2 && chunk_len > 0) {
            // โยนก้อน MP3 เข้า RingBuffer แบบไม่บล็อก
            xRingbufferSend(s_audio_ringbuf, abuf, chunk_len, pdMS_TO_TICKS(50));
        }
    }

    int64_t total_time_us = esp_timer_get_time() - t_playback_start;
    ESP_LOGI(TAG, "Playback Finished: %ld frames in %.2f s (Average: %.1f FPS)",
             decoded_frames, (float)total_time_us / 1000000.0f,
             (float)decoded_frames * 1000000.0f / (float)total_time_us);

    // ปิดและคืนทรัพยากร
    jpeg_del_decoder_engine(jpeg_dec);
    free(vbuf);
    free(abuf);
    AVI_close(avi);

    return ESP_OK;
}


