/* ── ขาควบคุม Backlight ─────────────────────────────────────────── */
// บอร์ด Waveshare ส่วนใหญ่ต่อ Backlight ไว้ที่ GPIO หรือผ่าน I2C IO Expander
// หากต่อตรงเข้า GPIO (เช่น GPIO 26 หรือ 27 ให้ระบุตรงนี้)
#define PIN_NUM_BK_LIGHT       GPIO_NUM_32

static esp_ldo_channel_handle_t ldo_mipi_phy = NULL;
static esp_lcd_panel_handle_t panel_handle = NULL;
static esp_lcd_dsi_bus_handle_t mipi_dsi_bus = NULL;
static esp_lcd_panel_io_handle_t mipi_dbi_io = NULL;

/* ── ฟังก์ชันเปิดไฟ Backlight ───────────────────────────────────── */
static void bsp_enable_backlight(void) {
    gpio_config_t bk_gpio_config = {
        .mode = GPIO_MODE_OUTPUT,
        .pin_bit_mask = 1ULL << PIN_NUM_BK_LIGHT
    };
    gpio_config(&bk_gpio_config);
    gpio_set_level(PIN_NUM_BK_LIGHT, 0);
}

#define LCD_H_RES       1024
#define LCD_V_RES       600
#define BOX_SIZE        80
#define BG_COLOR        0x0000

static const uint16_t BOX_COLORS[] = {
    0xF800, 0x07E0, 0x001F, 0xFFE0, 0x07FF, 0xF81F, 0xFD20, 0xFFFF
};
#define NUM_COLORS (sizeof(BOX_COLORS) / sizeof(BOX_COLORS[0]))

// Callback เมื่อฮาร์ดแวร์สแกนภาพจบ 1 เฟรม (VSYNC แท้จริง)
static bool dsi_dpi_panel_refresh_done_cb(esp_lcd_panel_handle_t panel, 
                                          esp_lcd_dpi_panel_event_data_t *edata, 
                                          void *user_ctx) {
    SemaphoreHandle_t sem = (SemaphoreHandle_t)user_ctx;
    BaseType_t high_task_woken = pdFALSE;
    xSemaphoreGiveFromISR(sem, &high_task_woken);
    return high_task_woken == pdTRUE;
}

static inline void draw_solid_rect(uint16_t *fb, int x, int y, int w, int h, uint16_t color) {
    for (int r = y; r < y + h; r++) {
        uint16_t *row = &fb[r * LCD_H_RES + x];
        for (int c = 0; c < w; c++) {
            row[c] = color;
        }
    }
}

void run_bouncing_box_official_style(esp_lcd_panel_handle_t panel_handle) {
    SemaphoreHandle_t vsync_sem = xSemaphoreCreateBinary();
    assert(vsync_sem != NULL);

    // 1. ลงทะเบียนเป็น on_refresh_done
    esp_lcd_dpi_panel_event_callbacks_t cbs = {
        .on_refresh_done = dsi_dpi_panel_refresh_done_cb,
    };
    ESP_ERROR_CHECK(esp_lcd_dpi_panel_register_event_callbacks(panel_handle, &cbs, vsync_sem));

    // ดึง Pointer ทั้ง 2 ตัว
    void *fbs[2] = {NULL, NULL};
    ESP_ERROR_CHECK(esp_lcd_dpi_panel_get_frame_buffer(panel_handle, 2, &fbs[0], &fbs[1]));
    
    memset(fbs[0], 0, LCD_H_RES * LCD_V_RES * sizeof(uint16_t));
    memset(fbs[1], 0, LCD_H_RES * LCD_V_RES * sizeof(uint16_t));

    // ยิง Frame 0 ขึ้นหน้าจอก่อนเป็น Front Buffer
    ESP_ERROR_CHECK(esp_lcd_panel_draw_bitmap(panel_handle, 0, 0, LCD_H_RES, LCD_V_RES, fbs[0]));

    int x = 100, y = 100;
    int vx = 6, vy = 5;
    int color_idx = 0;
    
    // สำคัญ: เริ่มต้นวาดที่ Buffer 1 (Back Buffer) เพื่อไม่ให้ชนกับ Buffer 0 ที่กำลังแสดงผล
    int draw_idx = 1; 

    int prev_x[2] = {x, x};
    int prev_y[2] = {y, y};

    while (1) {
        // รอสัญญาณ VSYNC จากฮาร์ดแวร์ (จะบล็อกเวลาไว้ที่ ~16.6ms พอดีเป๊ะ WDT ไม่ด่าแน่นอน)
        xSemaphoreTake(vsync_sem, portMAX_DELAY);

        x += vx;
        y += vy;

        bool hit = false;
        if (x <= 0) { x = 0; vx = -vx; hit = true; }
        else if (x + BOX_SIZE >= LCD_H_RES) { x = LCD_H_RES - BOX_SIZE; vx = -vx; hit = true; }

        if (y <= 0) { y = 0; vy = -vy; hit = true; }
        else if (y + BOX_SIZE >= LCD_V_RES) { y = LCD_V_RES - BOX_SIZE; vy = -vy; hit = true; }

        if (hit) {
            color_idx = (color_idx + 1) % NUM_COLORS;
        }

        uint16_t *active_fb = (uint16_t *)fbs[draw_idx];

        // เคลียร์ตำแหน่งเดิมของบัฟเฟอร์ตัวนี้
        draw_solid_rect(active_fb, prev_x[draw_idx], prev_y[draw_idx], BOX_SIZE, BOX_SIZE, BG_COLOR);

        // วาดตำแหน่งใหม่
        draw_solid_rect(active_fb, x, y, BOX_SIZE, BOX_SIZE, BOX_COLORS[color_idx]);

        prev_x[draw_idx] = x;
        prev_y[draw_idx] = y;

        // สั่งสลับบัฟเฟอร์ (ไดรเวอร์จะรอสลับหน้าตอนกวาดจอรอบหน้า)
        esp_lcd_panel_draw_bitmap(panel_handle, 0, 0, LCD_H_RES, LCD_V_RES, active_fb);

        // สลับไปวาดอีกตัวในรอบหน้า
        draw_idx = 1 - draw_idx;
    }
}

void app_main(void) {
    ESP_LOGI(TAG, "Initializing MIPI-DSI Host...");

    ESP_LOGI(TAG, "MIPI DSI PHY Powered on");
    esp_ldo_channel_config_t ldo_mipi_phy_config = {
        .chan_id = 3,//TEST_MIPI_DSI_PHY_PWR_LDO_CHAN,
        .voltage_mv = 2500,//TEST_MIPI_DSI_PHY_PWR_LDO_VOLTAGE_MV,
    };
    ESP_ERROR_CHECK(esp_ldo_acquire_channel(&ldo_mipi_phy_config, &ldo_mipi_phy));

    ESP_LOGI(TAG, "Initialize MIPI DSI bus");
    esp_lcd_dsi_bus_config_t bus_config = EK79007_PANEL_BUS_DSI_2CH_CONFIG();
    bus_config.lane_bit_rate_mbps = 1000;
    ESP_ERROR_CHECK(esp_lcd_new_dsi_bus(&bus_config, &mipi_dsi_bus));

    ESP_LOGI(TAG, "Install panel IO");
    esp_lcd_dbi_io_config_t dbi_config = EK79007_PANEL_IO_DBI_CONFIG();
    ESP_ERROR_CHECK(esp_lcd_new_panel_io_dbi(mipi_dsi_bus, &dbi_config, &mipi_dbi_io));

    ESP_LOGI(TAG, "Install LCD driver of ek79007");
#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(6, 0, 0)
    esp_lcd_dpi_panel_config_t dpi_config = EK79007_1024_600_PANEL_60HZ_CONFIG_CF(LCD_COLOR_FMT_RGB565);
    dpi_config.dpi_clock_freq_mhz = 70;
    dpi_config.num_fbs = 2;
#else
    esp_lcd_dpi_panel_config_t dpi_config = EK79007_1024_600_PANEL_60HZ_CONFIG(TEST_MIPI_DPI_PX_FORMAT);
#endif
    ek79007_vendor_config_t vendor_config = {
        .mipi_config = {
            .dsi_bus = mipi_dsi_bus,
            .dpi_config = &dpi_config,
            .lane_num = 2,//TEST_MIPI_DSI_LANE_NUM,
        },
    };
    const esp_lcd_panel_dev_config_t panel_config = {
        .reset_gpio_num = 33,//TEST_PIN_NUM_LCD_RST,
        .rgb_ele_order = LCD_RGB_ELEMENT_ORDER_RGB,
        .bits_per_pixel = 16,//TEST_LCD_BIT_PER_PIXEL,
        .vendor_config = &vendor_config,
    };
    
    ESP_ERROR_CHECK(esp_lcd_new_panel_ek79007(mipi_dbi_io, &panel_config, &panel_handle));
    //ESP_ERROR_CHECK(esp_lcd_dpi_panel_enable_dma2d(panel_handle));
    ESP_ERROR_CHECK(esp_lcd_panel_reset(panel_handle));
    ESP_ERROR_CHECK(esp_lcd_panel_init(panel_handle));

    /* 3. เปิด Backlight */
    bsp_enable_backlight();
    ESP_LOGI(TAG, "MIPI Panel Initialized successfully!");

    run_bouncing_box_official_style(panel_handle);
}