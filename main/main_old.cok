#define SPEEDTEST_URL "http://speed.cloudflare.com/__down?bytes=5000000"
#define DOWNLOAD_BUFFER_SIZE 8192

static void run_speed_test(void) {
    ESP_LOGI(TAG, "Starting Speed Test (Downloading 5 MB)...");

    esp_http_client_config_t config = {
        .url = SPEEDTEST_URL,
    .timeout_ms = 15000,
    .buffer_size = 16384,      // ขยาย RX Buffer ภายใน (เดิม 512 ไบต์)
    .buffer_size_tx = 4096,    // ขยาย TX Buffer
    };
    esp_http_client_handle_t client = esp_http_client_init(&config);
    if (!client) {
        ESP_LOGE(TAG, "Failed to initialize HTTP client");
        return;
    }

    esp_err_t err = esp_http_client_open(client, 0);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to open HTTP connection: %s", esp_err_to_name(err));
        esp_http_client_cleanup(client);
        return;
    }

    int content_length = esp_http_client_fetch_headers(client);
    ESP_LOGI(TAG, "Connected. Content-Length: %d bytes", content_length);

    char *buffer = malloc(DOWNLOAD_BUFFER_SIZE);
    if (!buffer) {
        ESP_LOGE(TAG, "Failed to allocate memory buffer");
        esp_http_client_close(client);
        esp_http_client_cleanup(client);
        return;
    }

    int total_read = 0;
    int read_bytes = 0;
    int64_t start_time = esp_timer_get_time();

    while ((read_bytes = esp_http_client_read(client, buffer, DOWNLOAD_BUFFER_SIZE)) > 0) {
        total_read += read_bytes;
    }

    int64_t end_time = esp_timer_get_time();
    float elapsed_sec = (end_time - start_time) / 1000000.0f;

    free(buffer);
    esp_http_client_close(client);
    esp_http_client_cleanup(client);

    if (elapsed_sec > 0 && total_read > 0) {
        float speed_kbps = (total_read / 1024.0f) / elapsed_sec;
        float speed_mbps = (total_read * 8.0f / 1000000.0f) / elapsed_sec;

        ESP_LOGI(TAG, "================ SPEED TEST RESULTS ================");
        ESP_LOGI(TAG, "Downloaded : %d bytes in %.2f seconds", total_read, elapsed_sec);
        ESP_LOGI(TAG, "Throughput : %.2f KB/s (%.2f Mbps)", speed_kbps, speed_mbps);
        ESP_LOGI(TAG, "====================================================");
    } else {
        ESP_LOGW(TAG, "Speed test completed with incomplete data");
    }
}

static void wait_and_sync_time(void) {
    ESP_LOGI(TAG, "Starting NTP Synchronization...");
    wifi_sntp_sync(); // เรียกฟังก์ชันที่มีอยู่เดิมในไลบรารีของคุณ

