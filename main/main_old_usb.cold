    lv_obj_set_size(card, 320, 180);
    lv_obj_center(card);
    lv_obj_set_style_bg_color(card, lv_color_hex(0x0F172A), 0);
    lv_obj_set_style_border_color(card, lv_color_hex(0x334155), 0);
    lv_obj_set_style_radius(card, 16, 0);
    lv_obj_set_style_pad_all(card, 16, 0);
    lv_obj_set_flex_flow(card, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(card, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

    // ป้ายข้อความหัวข้อ
    lv_obj_t *title = lv_label_create(card);
    lv_label_set_text(title, "ยอดเงินที่หยอด");
    lv_obj_set_style_text_color(title, lv_color_hex(0x94A3B8), 0);
    lv_obj_set_style_text_font(title, &anuphan_16, 0);

    // ตัวเลขยอดเงินรวม (สีเขียว ตัวหนา ขนาด 26px)
    s_coin_total_lbl = lv_label_create(card);
    lv_label_set_text(s_coin_total_lbl, "0.00 ฿");
    lv_obj_set_style_text_color(s_coin_total_lbl, lv_color_hex(0x22C55E), 0);
    lv_obj_set_style_text_font(s_coin_total_lbl, &anuphan_bold_26, 0);

    // แสดงจำนวนเหรียญสะสม
    s_coin_count_lbl = lv_label_create(card);
    lv_label_set_text(s_coin_count_lbl, "จำนวนเหรียญ: 0 เหรียญ");
    lv_obj_set_style_text_color(s_coin_count_lbl, lv_color_hex(0x64748B), 0);
    lv_obj_set_style_text_font(s_coin_count_lbl, &anuphan_14, 0);
}

void update_coin_display(double total_baht, uint32_t total_coins) {
    if (lvgl_port_lock(100)) {
        if (s_coin_total_lbl) {
            char buf[32];
            snprintf(buf, sizeof(buf), "%.2f บาท", total_baht); // ใช้ snprintf ของ C แทน
            lv_label_set_text(s_coin_total_lbl, buf);
        }
        if (s_coin_count_lbl) {
            char buf[64];
            snprintf(buf, sizeof(buf), "จำนวนเหรียญ: %u เหรียญ", (unsigned)total_coins);
            lv_label_set_text(s_coin_count_lbl, buf);
        }
        lvgl_port_unlock();
    }
}

#include "driver/gpio.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_log.h"

#define COIN_INPUT_GPIO         GPIO_NUM_2
#define COIN_SAMPLE_PERIOD_MS   2     // สุ่มอ่านทุก 2ms (พัลส์ 20ms จะถูกอ่านถึง 10 ครั้ง)
#define COIN_DEBOUNCE_MIN_MS    8     // ต้อง LOW ต่อเนื่องเกิน 8ms ถึงนับว่าเป็นพัลส์จริง (กัน Noise)
#define COIN_TRAIN_TIMEOUT_MS   250   // ถ้าไม่มีพัลส์เข้ามาเกิน 250ms ถือว่าจบ 1 เหรียญ

static double   s_accum_baht  = 0.0;
static uint32_t s_accum_coins = 0;

/* ฟังก์ชันตั้งค่า GPIO 2 เป็น Input พร้อมเปิดตัวต้านทาน Pull-up ภายใน */
static void coin_gpio_init(void) {
    gpio_config_t io_conf = {
        .pin_bit_mask = (1ULL << COIN_INPUT_GPIO),
        .mode         = GPIO_MODE_INPUT,
        .pull_up_en   = GPIO_PULLUP_ENABLE,   // ปกติขาจะลอยเป็น HIGH
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type    = GPIO_INTR_DISABLE,    // ปิด Interrupt ทั้งหมด
    };
    gpio_config(&io_conf);
}

/* Task วนลูปอ่านสัญญาณแบบ Polling */
void coin_reader_task(void *pvParam) {
    coin_gpio_init();

    uint32_t low_duration_ms     = 0;
    bool     pulse_registered    = false;
    uint32_t current_coin_pulses = 0;
    TickType_t last_pulse_tick   = 0;

    while (1) {
        vTaskDelay(pdMS_TO_TICKS(COIN_SAMPLE_PERIOD_MS));

        int level = gpio_get_level(COIN_INPUT_GPIO);

        // 1. ตรวจสอบสถานะ Active LOW (0 = มีสัญญาณพัลส์เข้ามา)
        if (level == 0) {
            low_duration_ms += COIN_SAMPLE_PERIOD_MS;

            // ตรวจสอบว่าสัญญาณ LOW แช่ยาวเกินค่า Debounce หรือไม่ (กันไฟกระชาก/สัญญาณรบกวน)
            if (!pulse_registered && (low_duration_ms >= COIN_DEBOUNCE_MIN_MS)) {
                current_coin_pulses++;
                pulse_registered = true;
                last_pulse_tick  = xTaskGetTickCount();
                ESP_LOGI("COIN", "Pulse detected! (Count in train: %u)", (unsigned)current_coin_pulses);
            }
        } else {
            // สัญญาณกลับมาเป็น HIGH (Idle)
            low_duration_ms  = 0;
            pulse_registered = false;
        }

        // 2. ตรวจสอบ Timeout สิ้นสุดชุดพัลส์ของเหรียญนั้นๆ (Pulse Train Timeout)
        if (current_coin_pulses > 0) {
            TickType_t elapsed_ticks = xTaskGetTickCount() - last_pulse_tick;
            
            if (elapsed_ticks > pdMS_TO_TICKS(COIN_TRAIN_TIMEOUT_MS)) {
                // เครื่องหยอดเหรียญทั่วไป: 1 พัลส์ = 1 บาท, 5 พัลส์ = 5 บาท, 10 พัลส์ = 10 บาท
                double coin_val = (double)current_coin_pulses;

                s_accum_baht  += coin_val;
                s_accum_coins += 1;

                ESP_LOGI("COIN", "Coin Inserted: %.2f THB (Total: %.2f THB, %u Coins)", 
                         coin_val, s_accum_baht, (unsigned)s_accum_coins);

                // สั่งอัปเดตตัวเลขขึ้นหน้าจอ LVGL ทันที
                update_coin_display(s_accum_baht, s_accum_coins);

                // ล้างค่านับพัลส์เพื่อรอเหรียญถัดไป
                current_coin_pulses = 0;
            }
        }
    }
}

vd_menu_content_t *content;

const char *setting_title[] = {"ตั้งค่าทั่วไป", "สินค้าและช่องจำหน่าย", "รายการรับ-จ่าย", "ระบบชำระเงิน", "เครือข่าย", "ทดสอบอุปกรณ์", "จัดการโฆษณา"};

typedef enum {
    /* กลุ่มที่ 1: การขายและสต็อก */
    MENU_ID_PRODUCT_MGR = 1,
    MENU_ID_PAYMENT,
    MENU_ID_TRANSACTIONS,

    /* กลุ่มที่ 2: ระบบและสื่อ */
    MENU_ID_GENERAL,
    MENU_ID_ADS_MGR,

    /* กลุ่มที่ 3: งานช่างและเครือข่าย */
    MENU_ID_NETWORK,
    MENU_ID_DEV_TEST,
    MENU_ID_FILE_MGR,
} vd_menu_id_t;

void create_settings_page_view(vd_menu_content_t *content);
void create_network_settings_page(vd_menu_content_t *content);
void create_products_settings_page(vd_menu_content_t *content);
void create_file_setting_page(vd_menu_content_t *content);

static uint32_t s_pending_menu_id = 0;
static bool     s_menu_switch_queued = false;

/* ทำงานหลัง event/indev จบสมบูรณ์แล้ว — ปลอดภัยที่จะลบ-สร้าง object ได้เต็มที่ */
static void _menu_switch_async_cb(void *param) {
    (void)param;
    s_menu_switch_queued = false;

    if (!content) return;

    /* ตัดการอ้างอิงของระบบสัมผัสออกจาก object เก่าทั้งหมดก่อนลบ */
    lv_indev_reset(NULL, NULL);

    vd_menu_content_clear(content);

    switch (s_pending_menu_id) {
        case MENU_ID_GENERAL:     create_settings_page_view(content);     break;
        case MENU_ID_NETWORK:     create_network_settings_page(content);  break;
        case MENU_ID_PRODUCT_MGR: create_products_settings_page(content); break;
        case MENU_ID_FILE_MGR:    create_file_setting_page(content);      break;
        default: break;
    }
}

static void _on_sidebar_menu_click(vd_menu_sidebar_t *sidebar, uint32_t item_id, const char *title, void *user_data) {
    if (item_id == VD_MENU_EXIT_ITEM_ID) {
        printf("กดปุ่มออกจากหน้าตั้งค่า");
        // สลับกลับหน้าขาย หรือปิดหน้าตั้งค่า
        return;
    }

     s_pending_menu_id = item_id;          /* เก็บ id ล่าสุดไว้ */

    if (!s_menu_switch_queued) {          /* กันกดรัว ๆ แล้วคิวซ้อนกันหลายอัน */
        s_menu_switch_queued = true;
        lv_async_call(_menu_switch_async_cb, NULL);
    }
}

static const char *s_thai_days[] = {
    "วันอาทิตย์", "วันจันทร์", "วันอังคาร", "วันพุธ", "วันพฤหัสบดี", "วันศุกร์", "วันเสาร์"
};

static const char *s_thai_months[] = {
    "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
    "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"
};

/* 2. โครงสร้าง Handle ตัวเก็บพอยน์เตอร์ Label ทั้งสองตัว */
typedef struct {
    lv_obj_t *time_label;
    lv_obj_t *date_label;
} time_display_handles_t;

void get_thai_date_string(time_t *now, char *buf, size_t buf_size) {
    if (!now || !buf || buf_size == 0) return;

    struct tm timeinfo;
    localtime_r(now, &timeinfo);

    int year_be = (timeinfo.tm_year + 1900) + 543;

    snprintf(buf, buf_size, "%sที่ %d %s %d",
             s_thai_days[timeinfo.tm_wday],
             timeinfo.tm_mday,
             s_thai_months[timeinfo.tm_mon],
             year_be);
}

/* 4. ฟังก์ชันแปลงเวลาภาษาไทย */
void get_thai_time_string(time_t *now, char *buf, size_t buf_size) {
    if (!now || !buf || buf_size == 0) return;

    struct tm timeinfo;
    localtime_r(now, &timeinfo);

    snprintf(buf, buf_size, "%02d:%02d:%02d น.",
             timeinfo.tm_hour,
             timeinfo.tm_min,
             timeinfo.tm_sec);
}

/* 5. Callback ของ Timer (วางไว้ก่อนหน้าจุดที่เรียกสร้าง timer เสมอ) */
void time_cb(lv_timer_t *tmr) {
    if (!tmr) return; // ป้องกัน Crash หากมีการส่ง NULL เข้ามา

    time_display_handles_t *handles = (time_display_handles_t *)lv_timer_get_user_data(tmr);
    if (!handles || !handles->time_label || !handles->date_label) return;

    time_t now = time(NULL);

    char time_str[32];
    char date_str[128];

    get_thai_time_string(&now, time_str, sizeof(time_str));
    get_thai_date_string(&now, date_str, sizeof(date_str));

    lv_label_set_text(handles->time_label, time_str);
    lv_label_set_text(handles->date_label, date_str);
}

/* ฟังก์ชันตัวช่วยลบ Timer อัตโนมัติเมื่อ Label โดนทำลาย */
static void _auto_delete_timer_cb(lv_event_t *e) {
    lv_timer_t *tmr = (lv_timer_t *)lv_event_get_user_data(e);
    if (tmr) lv_timer_delete(tmr);
}

void create_settings_page_view(vd_menu_content_t *content) {
  // 4. สร้างหัวข้อหลักบนสุด (Main Title)
