    lv_obj_t *lbl_btn = lv_label_create(s_btn_manual_check);
    lv_label_set_text(lbl_btn, "ตรวจสอบสถานะ");
    lv_obj_set_style_text_font(lbl_btn, &anuphan_semi_bold_16, 0);
    lv_obj_center(lbl_btn);

    // 5. ป้ายข้อความแสดงผลการตรวจสอบ
    s_lbl_manual_result = lv_label_create(card);
    lv_label_set_text(s_lbl_manual_result, "ระบุหมายเลข Order ID แล้วกดตรวจสอบ");
    lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0x94A3B8), 0);
    lv_obj_set_style_text_font(s_lbl_manual_result, &anuphan_16, 0);
    lv_obj_set_style_pad_top(s_lbl_manual_result, 10, 0);

    // 6. แป้นพิมพ์ QWERTY
    s_kb_manual = lv_keyboard_create(parent);
    lv_keyboard_set_textarea(s_kb_manual, s_ta_manual_order);
    lv_obj_set_size(s_kb_manual, 650, 230);
    lv_obj_align(s_kb_manual, LV_ALIGN_BOTTOM_MID, 0, -10);
    lv_obj_add_event_cb(s_kb_manual, _kb_manual_event_cb, LV_EVENT_ALL, NULL);
    lv_obj_add_flag(s_kb_manual, LV_OBJ_FLAG_HIDDEN);
}

static lv_obj_t *s_coin_total_lbl = NULL;
static lv_obj_t *s_coin_count_lbl = NULL;

/* 1. สร้างการ์ดแสดงยอดเงินหยอดเหรียญ */
void create_simple_coin_counter_ui(lv_obj_t *parent) {
    if (!parent) parent = lv_screen_active();

    // กล่องการ์ดพื้นหลังสีเข้ม (320 x 180 px) วางกึ่งกลางจอ
