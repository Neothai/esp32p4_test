#define DEMO_SLOTS_COUNT (sizeof(s_demo_slots) / sizeof(s_demo_slots[0]))

/* ── 1. ดักรับค่าเมื่อผู้ใช้กด "บันทึก" ── */
static void app_slot_on_save(vd_slot_data_t *slot, void *user_data) {
    printf("[App] บันทึกช่อง %s: ชื่อ=%s, ราคา=%u, สต็อก=%u, ปิดขาย=%d\n",
           slot->code, slot->product, (unsigned)slot->price, slot->stock, slot->disabled);

    // TODO: บันทึกข้อมูลลง NVS / Flash ของ ESP32 เพื่อให้ค่าไม่หายเมื่อดับไฟ
    // nvs_set_blob(my_nvs_handle, slot->code, slot, sizeof(vd_slot_data_t));
    // nvs_commit(my_nvs_handle);

    // รีเฟรชผังช่องจำหน่ายบนหน้าจอให้เป็นปัจจุบัน
    if (content) {
        vd_menu_content_clear(content);
        create_products_settings_page(content);
    }
}

/* ── 2. ดักรับคำสั่งเมื่อผู้ใช้กดปุ่ม "ทดสอบ" มอเตอร์ ── */
static void app_slot_on_motor_test(const char *slot_code, void *user_data) {
    printf("[Hardware] สั่งหมุนมอเตอร์ช่อง: %s\n", slot_code);

    // TODO: สั่งบอร์ดขับมอเตอร์ (เช่น ส่งคำสั่งผ่าน I2C/RS485 หรือยิง Pulse ขา GPIO)
    // driver_motor_dispense_slot(slot_code);

    // ตัวอย่างจำลอง: เมื่อมอเตอร์หมุนครบรอบ (หรือ Microswitch ตรวจจับสำเร็จ)
    // ให้เรียกฟังก์ชันนี้เพื่อส่งข้อความกลับไปแจ้งบน UI:
    bool motor_ok = true; // ตรวจสอบสถานะจริงจากเซนเซอร์ตรวจจับ
    if (motor_ok) {
        vd_slot_modal_set_motor_result(true, "หมุนปกติ ทดสอบสำเร็จ");
    } else {
        vd_slot_modal_set_motor_result(false, "เกิดข้อผิดพลาด มอเตอร์ติดขัด!");
    }
}

static void app_slot_custom_image_loader(lv_obj_t *img_obj, const char *src_path, void *user_data) {
    printf("[ImageLoader] กำลังโหลดภาพจากพาธ: %s\n", src_path);

    // ตัวอย่างที่ 1: ตรวจสอบและแมปชื่อไฟล์เป็น Image Descriptor ในหน่วยความจำ[cite: 19]
    if (strstr(src_path, "greentea")) {
        extern const lv_image_dsc_t greentea;
        lv_image_set_src(img_obj, &greentea);
        return;
    }

    // ตัวอย่างที่ 2: ถ้าเป็นพาธบน SD Card หรือระบบไฟล์ของ ESP32[cite: 19]
    // LVGL v9 รองรับการใส่ Path ได้โดยตรงหากเปิดใช้งานไดรเวอร์ FS
    lv_image_set_src(img_obj, src_path);
}

/* ผูก Callback เข้ากับ Modal Structure */
static const vd_slot_modal_cbs_t s_modal_callbacks = {
    .on_save       = app_slot_on_save,
    .on_motor_test = app_slot_on_motor_test,
    .on_close      = NULL,
    .on_set_image  = app_slot_custom_image_loader // ★ ส่งฟังก์ชันของคุณเข้าไปที่นี่
};

static void _on_slot_clicked(lv_event_t *e) {
    vd_slot_data_t *slot = (vd_slot_data_t *)lv_event_get_user_data(e);
    if (!slot) return;

    // เปิดหน้าต่างพร้อมส่งโครงสร้าง Callback ทั้งชุดเข้าไป
    vd_slot_edit_modal_open(slot, 2, &s_modal_callbacks, NULL);
}

void create_products_settings_page(vd_menu_content_t *content) {
    vd_menu_content_add_title(content, "สินค้าและช่องจำหน่าย");

    // ── ทดสอบเรียกใช้ฟังก์ชันปรับแต่งค่า ──
    vd_slot_set_capacity(&s_demo_slots[0], 20);   // ปรับ A1 ให้จุได้ 20 ชิ้น
    vd_slot_set_threshold(&s_demo_slots[0], 5);  // เตือนเหลือน้อยเมื่อ A1 <= 5 ชิ้น

    vd_menu_sub_frame_t *card_grid = vd_menu_sub_frame_create(content, NULL);
    lv_obj_t *card_obj = vd_menu_sub_frame_get_card(card_grid);

    // Header Row
    lv_obj_t *header_row = lv_obj_create(card_obj);
    lv_obj_remove_style_all(header_row);
    lv_obj_set_width(header_row, lv_pct(100));
    lv_obj_set_height(header_row, LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(header_row, LV_FLEX_FLOW_ROW);
    lv_obj_set_flex_align(header_row, LV_FLEX_ALIGN_SPACE_BETWEEN, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    lv_obj_set_style_pad_bottom(header_row, 12, 0);
    lv_obj_set_ext_draw_size(header_row, 15);
    lv_obj_set_overflow_visible(header_row, true);

    lv_obj_t *f_title = lv_label_create(header_row);
    lv_label_set_text(f_title, "ผังช่องจำหน่าย");
    lv_obj_set_style_text_font(f_title, &anuphan_bold_16, 0);
    lv_obj_set_style_text_color(f_title, VD_MENU_COLOR_TITLE, 0);

    vd_menu_slot_legend_create(header_row);

    // ★ สร้างผังแบบกำหนดคอลัมน์ (เช่น เปลี่ยนเป็น 4 คอลัมน์ หรือ 6 คอลัมน์ได้อิสระ)
    // ส่ง cols = 4, default_low_threshold = 2
    vd_menu_slot_grid_create(card_obj, s_demo_slots, DEMO_SLOTS_COUNT, 4, 2, _on_slot_clicked, NULL);

    // สรุปยอดสถานะรวม
    //vd_menu_slot_stats_create(card_obj, s_demo_slots, DEMO_SLOTS_COUNT, 2);

    // ── การ์ดที่ 2: การแจ้งเตือนสินค้า ──
    vd_menu_sub_frame_t *card_alert = vd_menu_sub_frame_create(content, "การแจ้งเตือนสินค้า");
    vd_menu_sub_content_add_switch(card_alert, "แจ้งเตือนสินค้าใกล้หมด",
                                  "ส่งการแจ้งเตือนถึงผู้ดูแลผ่านเซิร์ฟเวอร์กลางเมื่อช่องใดเหลือสินค้าต่ำกว่าค่าที่กำหนด",
                                  true, NULL, NULL);
    vd_menu_sub_content_add_stepper(card_alert, "แจ้งเตือนเมื่อเหลือไม่เกิน",
                                   "ช่องที่เหลือสินค้าไม่เกินจำนวนนี้จะถูกทำเครื่องหมาย \"เหลือน้อย\" ในผังด้านบน",
                                   2, "ชิ้น", NULL, NULL);
    vd_menu_sub_content_add_switch(card_alert, "แสดงป้าย \"ขายหมด\" บนจอฝั่งลูกค้า",
                                  "วาดป้ายทับช่องที่สินค้าหมด เพื่อไม่ให้ลูกค้าพยายามเลือกซื้อ",
                                  true, NULL, NULL);
}

/* ตัวอย่าง Mock Callback ดึงไดรฟ์ */
static bool app_fs_get_drives(vd_drive_info_t **out_drives, uint32_t *out_count, void *user_data) {
    uint32_t count = 3;
    vd_drive_info_t *drives = (vd_drive_info_t *)calloc(count, sizeof(vd_drive_info_t));
    if (!drives) return false;

    drives[0].id = strdup("flash");
    drives[0].name = strdup("หน่วยความจำภายใน");
    drives[0].used_mb = 2450;
    drives[0].total_mb = 16384;

    drives[1].id = strdup("sd");
    drives[1].name = strdup("การ์ด SD");
    drives[1].used_mb = 2900;
    drives[1].total_mb = 16384;

    drives[2].id = strdup("usb");
    drives[2].name = strdup("USB Drive");
    drives[2].used_mb = 520;
    drives[2].total_mb = 8192;

    *out_drives = drives;
    *out_count = count;
    return true;
}

/* ตัวอย่าง Mock Callback ดึงรายการไฟล์ในโฟลเดอร์ */
static bool app_fs_list_dir(const char *drive_id, const char *path, vd_file_item_t **out_items, uint32_t *out_count, void *user_data) {
    printf("[FS] List dir on drive: %s, path: %s\n", drive_id, path);

    // ตัวอย่าง: ถ้าอยู่ที่ Root "/" ให้คืนโฟลเดอร์หมวดหมู่
    if (strcmp(path, "/") == 0) {
        uint32_t count = 3;
        vd_file_item_t *items = (vd_file_item_t *)calloc(count, sizeof(vd_file_item_t));
        if (!items) return false;

        items[0].name = strdup("สินค้า");
        items[0].type = VD_FILE_TYPE_DIR;
        items[0].size_kb = 4; // จำนวน 4 รายการ

        items[1].name = strdup("วิดีโอโฆษณา");
        items[1].type = VD_FILE_TYPE_DIR;
        items[1].size_kb = 2;

        items[2].name = strdup("config.json");
        items[2].type = VD_FILE_TYPE_TXT;
        items[2].size_kb = 12;

        *out_items = items;
        *out_count = count;
        return true;
    }
    // ตัวอย่าง: ถ้าเข้ามาใน "/สินค้า"
    else if (strcmp(path, "/สินค้า") == 0) {
        uint32_t count = 2;
        vd_file_item_t *items = (vd_file_item_t *)calloc(count, sizeof(vd_file_item_t));
        if (!items) return false;

        items[0].name = strdup("greentea.png");
        items[0].type = VD_FILE_TYPE_IMG;
        items[0].size_kb = 420;

        items[1].name = strdup("latte.png");
        items[1].type = VD_FILE_TYPE_IMG;
        items[1].size_kb = 380;

        *out_items = items;
        *out_count = count;
        return true;
    }

    // โฟลเดอร์อื่นว่างเปล่า
    *out_items = NULL;
    *out_count = 0;
    return true;
}

/* Callback เมื่อคลิกไฟล์ */
