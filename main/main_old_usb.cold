    lv_obj_set_style_text_font(s_ta_manual_order, &anuphan_16, 0);
    lv_obj_add_event_cb(s_ta_manual_order, _ta_manual_event_cb, LV_EVENT_ALL, NULL);

    // 4. ปุ่มกดตรวจสอบ
    s_btn_manual_check = lv_button_create(card);
