                                      "VD-ASM-001", 24);

    // แถวที่ 2: รหัสเครื่อง (Serial No.) (ใช้ Slot อิสระ นำ Badge + ปุ่ม Copy มารวมกัน)
    lv_obj_t *slot_serial = vd_menu_sub_content_create(frame_info,
                                                       "รหัสเครื่อง (Serial No.)",
                                                       "รหัสประจำเครื่อง ใช้อ้างอิงเมื่อติดต่อศูนย์บริการ");
    // วาง Badge
    lv_obj_t *badge = lv_label_create(slot_serial);
    lv_label_set_text(badge, "VM-2026-0135");
    lv_obj_set_style_text_font(badge, &anuphan_semi_bold_16, 0);

    // วางปุ่ม Copy ข้างๆ
    lv_obj_t *btn_copy = lv_button_create(slot_serial);
    lv_obj_set_size(btn_copy, 32, 32);
    lv_obj_t *ic = lv_label_create(btn_copy);
    lv_label_set_text(ic, "\uf0c5"); // Font Awesome Copy
    lv_obj_center(ic);

    // แถวที่ 3: สถานที่ตั้ง
    vd_menu_sub_content_add_text_input(frame_info,
                                      "สถานที่ตั้ง",
                                      "ระบุตำแหน่งติดตั้ง ช่วยในการหาเครื่องและจัดสายเติมสินค้า",
                                      "อาคารเรียนรวม ชั้น 1 โซน B", 60);

    vd_menu_sub_content_add_static_badge(frame_info,
                                        "เวอร์ชันซอฟต์แวร์",
                                        "อัปเดตล่าสุด 12 ส.ค. 2569",
                                        "เวอร์ชัน 2.4.1 (ล่าสุด)");

    vd_menu_sub_frame_t *frame_language = vd_menu_sub_frame_create(content, "ภาษา");
    const char *lang_choices[] = {"ไทย", "English"};
    vd_menu_sub_content_add_button_group(frame_language,
                                      "ภาษาของระบบ",
                                      "ภาษาของหน้า interface ทั้งฝั่งลูกค้าและระบบ",
                                      lang_choices, 2, 0,
                                      NULL, NULL);

    vd_menu_sub_frame_t *frame_time = vd_menu_sub_frame_create(content, "วันที่และเวลา");
    vd_menu_sub_content_add_switch(frame_time,
                                  "ซิงค์เวลาอัตโนมัติ",
                                  "รับเวลาจากเซิร์ฟเวอร์อินเทอร์เน็ต (NTP) เมื่อเชื่อมต่อเครือข่าย",
                                  true, NULL, NULL);
    lv_obj_t *timenow_bg = vd_menu_sub_content_create(frame_time, "เวลาปัจจุบันของระบบ", NULL);

    // 2. ปรับกล่องนี้ให้เรียงเป็นแนวตั้ง (บนลงล่าง) และผลักชิดขวาสุด
    lv_obj_set_flex_flow(timenow_bg, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(timenow_bg,
                          LV_FLEX_ALIGN_CENTER, /* แกนหลัก (แนวตั้ง): กึ่งกลาง */
                          LV_FLEX_ALIGN_END,    /* แกนตัด (แนวนอน): ดันเนื้อหาทั้งหมดชิดขวาสุด */
                          LV_FLEX_ALIGN_CENTER);
    lv_obj_set_style_pad_row(timenow_bg, 2, 0); /* ระยะห่างระหว่างบรรทัดเวลาและวันที่ */

    // 3. บรรทัดบน: เวลาปัจจุบัน (สร้างก่อน จะอยู่ด้านบนอัตโนมัติ)
    lv_obj_t *timenow_txt = lv_label_create(timenow_bg);
    lv_obj_set_style_text_font(timenow_txt, &anuphan_bold_16, 0);
    lv_obj_set_style_text_color(timenow_txt, VD_MENU_COLOR_ACCENT, 0);

    lv_obj_t *timenow_full_txt = lv_label_create(timenow_bg);
    lv_obj_set_style_text_font(timenow_full_txt, &anuphan_12, 0);
    lv_obj_set_style_text_color(timenow_full_txt, lv_color_hex(0x9CA3AF), 0);

    static time_display_handles_t s_time_handles;
    s_time_handles.time_label = timenow_txt;
    s_time_handles.date_label = timenow_full_txt;

    lv_timer_t *timenow_timer = lv_timer_create(time_cb, 500, &s_time_handles);
    lv_obj_add_event_cb(timenow_txt, _auto_delete_timer_cb, LV_EVENT_DELETE, timenow_timer);

    vd_menu_sub_frame_t *frame_display = vd_menu_sub_frame_create(content, "จอภาพและระบบเสียง");
    vd_menu_sub_content_add_slider(frame_display, "\uf185", "ความสว่างหน้าจอ", "แนะนำ 70-85% สำหรับตู้ในร่ม, 95% ขึ้นไปสำหรับจุดที่แดดส่อง", 20, 100, 80, "%", NULL);

    vd_menu_sub_frame_t *frame_operation = vd_menu_sub_frame_create(content, "ระยะเวลาให้บริการ");
    lv_obj_t *svc_time = vd_menu_sub_content_add_time_range(frame_operation, "เวลาเปิด-ปิดให้บริการ", "ปรับได้ทีละ 15 นาที", "06:00", "22:00", NULL, NULL);

    // ปรับ Step ของนาทีเป็น 15 นาที (ชม. ทีละ 1)
    vd_menu_time_range_set_step(svc_time, 1, 5, 1);
}

