uint8_t prod_img_cnt;

lv_image_dsc_t prod_img_dsc[10];
bool __read_all_prod_img_ok = false;

void lvgl_main(void *pv_param) {
  check_task_stack("LVGL_START", NULL);
  if (lvgl_port_lock(0)) {
    tile_view = lv_tileview_create(lv_screen_active());
    sale_page = lv_tileview_add_tile(tile_view, 0, 0, LV_DIR_LEFT);
    lv_obj_set_style_pad_left(sale_page, 0, 0);

    /*apply_thai_font_hook((lv_font_t *)&anuphan_14);
    apply_thai_font_hook((lv_font_t *)&anuphan_16);
    apply_thai_font_hook((lv_font_t *)&anuphan_semi_bold_16);
    apply_thai_font_hook((lv_font_t *)&anuphan_bold_16);
    apply_thai_font_hook((lv_font_t *)&anuphan_18);
    apply_thai_font_hook((lv_font_t *)&anuphan_med_18);
    apply_thai_font_hook((lv_font_t *)&anuphan_semi_bold_18);
    apply_thai_font_hook((lv_font_t *)&anuphan_20);
    apply_thai_font_hook((lv_font_t *)&anuphan_bold_20);
    apply_thai_font_hook((lv_font_t *)&anuphan_med_22);
    apply_thai_font_hook((lv_font_t *)&anuphan_bold_18);
    apply_thai_font_hook((lv_font_t *)&anuphan_22);
    apply_thai_font_hook((lv_font_t *)&anuphan_bold_22);
    apply_thai_font_hook((lv_font_t *)&anuphan_bold_24);
    apply_thai_font_hook((lv_font_t *)&anuphan_bold_26);*/
    anuphan_18.fallback = &font_awesome_20;

    keyboard = lvgl_thai_kb_create(lv_screen_active(), &anuphan_18);

    vd_home_page = vd_home_page_create(sale_page, LCD_H_RES, LCD_V_RES, item_checkout_cb);
    lv_obj_set_state(vd_home_page->prod_search_ta, LV_STATE_FOCUSED, false);

    vd_task_mgr_register_task(xTaskGetCurrentTaskHandle());
    vd_task_manager_create(lv_layer_top());

    lvgl_port_unlock();

    log_system_memory();
    check_task_stack("LVGL_END", NULL);
  }

  while (1) {
    vTaskDelay(pdMS_TO_TICKS(10));

    if(__read_all_prod_img_ok){
      if (lvgl_port_lock(1000)) {
      __read_all_prod_img_ok = false;
      for (int i = 0; i < prod_img_cnt; i++) {
        bool is_promotion = i % 2 == 0;
        vd_prod_card_create(vd_home_page, "ข้าวผัดกะเพรา", 60.0, is_promotion ? 50.0 : 0, &prod_img_dsc[i], prod_card_clicked_cb);
      }
      lvgl_port_unlock();
    }
    }

    if (__start_qr) {
      __start_qr = false;
      vTaskDelay(pdMS_TO_TICKS(4000)); // รอจำลองการสร้าง QR

      // 1. ถือรหัสความปลอดภัยก่อนเข้ายุ่งกับ LVGL (รอจนกว่าจะได้สิทธิ์)
      if (lvgl_port_lock(1000)) { // รอคิวได้สูงสุด 1 วินาที
        size_t png_data_size = 0;

        if(raw_qr_img) {
          free(raw_qr_img);
          raw_qr_img = NULL;
        }

        raw_qr_img = vd_base64_decode(qr_b64data, &png_data_size);

        if (raw_qr_img && png_data_size > 0) {
          qr_img_dsc.header.magic = LV_IMAGE_HEADER_MAGIC;
          qr_img_dsc.header.cf = LV_COLOR_FORMAT_RAW;
          qr_img_dsc.header.w = 0;
          qr_img_dsc.header.h = 0;
          qr_img_dsc.data_size = png_data_size;
          qr_img_dsc.data = raw_qr_img;

          // ตรวจสอบความถูกต้องของ Pointer ก่อนเรียกใช้
          if (dialog && dialog->qr_img) {
            vd_payment_opt_set_qr_data(dialog, &qr_img_dsc, 12000);
            vd_payment_opt_send_loading_ok_signal(dialog);
          } else {
            ESP_LOGE("PAYMENT", "Invalid dialog or qr_img pointer!");
          }
        } else {
          ESP_LOGE("PAYMENT", "Base64 decode failed!");
        }

        lvgl_port_unlock(); // ปล่อยคืนสิทธิ์ทุกครั้ง
      }
    }
  }
}

bool img_cb(const char *file_path, const char *file_name, size_t file_size, void *user_data) {
  if (prod_img_cnt == 10) {
    __read_all_prod_img_ok = false;
    return false;
  }

  esp_err_t err = vd_sd_read_file(file_path, &prod_img_buf[prod_img_cnt], &file_size, true);
  if (err != ESP_OK) return false;

  vd_img_info_t img_info = {};
  vd_img_type_t img_type = vd_img_check_type(prod_img_buf[prod_img_cnt], file_size, &img_info);

  if(img_type == VD_IMG_TYPE_JPG) {
    uint32_t out_w = 0, out_h = 0;
    size_t out_size = 0;

    // บรรทัดเดียวจบ: จองแรม Aligned + ถอดรหัสให้เสร็จสรรพ
    err = vd_img_jpg_dec(prod_img_buf[prod_img_cnt], file_size, 
                         &prod_raw_img_buf[prod_img_cnt], &out_size, &out_w, &out_h);

    if (err == ESP_OK) {
      // สร้าง LVGL Descriptor
      img_info.width  = out_w;
      img_info.height = out_h;
      vd_img_jpg_to_lv_dsc(prod_raw_img_buf[prod_img_cnt], out_size, &img_info, &prod_img_dsc[prod_img_cnt]);
    }
  }

  free(prod_img_buf[prod_img_cnt]);
  prod_img_cnt++;

  return true;
}

static lv_obj_t *avi_video = NULL;
static lv_obj_t *s_ctrl_bar          = NULL;
static lv_obj_t *s_slider            = NULL;
static lv_obj_t *s_slider_time       = NULL;
static lv_obj_t *s_play_pause_btn    = NULL;
static lv_obj_t *s_play_pause_txt    = NULL;
static lv_timer_t *s_video_sync_timer = NULL;

static bool s_is_scrubbing = false; // ป้องกัน Slider เด้งกลับจังหวะที่ผู้ใช้นิ้วกดลากค้างไว้

#include "driver/i2s_std.h"
#include "freertos/ringbuf.h"
#include "helix/pub/mp3dec.h"

static i2s_chan_handle_t s_i2s_tx_chan = NULL;
static RingbufHandle_t   s_audio_ringbuf = NULL;
static TaskHandle_t      s_audio_task_hdl = NULL;
static uint32_t          s_current_audio_rate = 0;
static volatile bool s_audio_flush      = false;

static uint32_t s_stat_audio_in_bytes = 0;
static uint32_t s_stat_audio_in_chunks = 0;
static uint32_t s_stat_audio_dropped_chunks = 0;

/* ตรวจสอบว่าเป็นไฟล์ AVI หรือไม่ */
static bool _is_avi_file(const char *filename) {
    if (!filename) return false;
    const char *dot = strrchr(filename, '.');
    if (!dot) return false;
    return (strcasecmp(dot, ".avi") == 0);
}

/* แปลงขนาดไบต์เป็นข้อความ KB หรือ MB */
static void _format_size_str(size_t bytes, char *buf, size_t buf_sz) {
    if (bytes >= 1024 * 1024) {
        snprintf(buf, buf_sz, "%.1f MB", (float)bytes / (1024.0f * 1024.0f));
    } else {
        snprintf(buf, buf_sz, "%u KB", (unsigned)(bytes / 1024));
    }
}

static lv_obj_t *s_playlist_panel = NULL;
static lv_obj_t *s_playlist_list  = NULL;
static char      s_current_playing_file[64] = "output.avi"; // บันทึกชื่อไฟล์ที่กำลังเล่นอยู่

/* Event เมื่อแตะเลือกไฟล์ในรายการ */
static void _playlist_item_click_cb(lv_event_t *e) {
    lv_obj_t *item_btn = lv_event_get_target(e);
    lv_obj_t *target_video = (lv_obj_t *)lv_event_get_user_data(e);
    const char *fname = (const char *)lv_obj_get_user_data(item_btn);
    if (!fname || !target_video) return;

    // สร้าง Full Path
    char full_path[128];
    snprintf(full_path, sizeof(full_path), "0:/%s", fname);
    ESP_LOGI(TAG, "Selected Video: %s", full_path);

    // 1. สั่งหยุดและเปลี่ยนไฟล์เล่นทันที
    vd_avi_set_src(target_video, full_path);
    vd_avi_play(target_video);

    // 2. จำชื่อไฟล์และอัปเดตสถานะ Highlight
    strncpy(s_current_playing_file, fname, sizeof(s_current_playing_file) - 1);

    // 3. ปิดแผง Playlist ลงอัตโนมัติ
    lv_obj_add_flag(s_playlist_panel, LV_OBJ_FLAG_HIDDEN);
}

/* ฟังก์ชันสแกน SD Card แล้วเติมรายการลงใน LVGL List */
static void _populate_avi_playlist(lv_obj_t *list, lv_obj_t *target_video) {
    lv_obj_clean(list); // ล้างรายการเดิม

    DIR dir;
    FILINFO fno;
    FRESULT fr = f_opendir(&dir, "0:/");
    if (fr != FR_OK) {
        ESP_LOGE(TAG, "Cannot open SD root 0:/ (err=%d)", fr);
        return;
    }

    uint32_t count = 0;
    while (f_readdir(&dir, &fno) == FR_OK && fno.fname[0] != 0) {
        if (!(fno.fattrib & AM_DIR) && _is_avi_file(fno.fname)) {
            count++;

            // สร้างปุ่มรายการขนาดแตะง่าย (สูง 52px)
            lv_obj_t *btn = lv_button_create(list);
            lv_obj_set_size(btn, lv_pct(100), 52);
            lv_obj_set_style_radius(btn, 8, 0);
            lv_obj_set_style_pad_hor(btn, 12, 0);
            lv_obj_set_style_pad_ver(btn, 6, 0);

            // ไฮไลต์ไฟล์ที่กำลังเล่นอยู่
            bool is_cur = (strcmp(s_current_playing_file, fno.fname) == 0);
            lv_obj_set_style_bg_color(btn, is_cur ? lv_color_hex(0x5B6EF5) : lv_color_hex(0x1E293B), 0);
            lv_obj_set_style_border_color(btn, lv_color_hex(0x334155), 0);
            lv_obj_set_style_border_width(btn, 1, 0);
            lv_obj_set_style_shadow_width(btn, 0, 0);

            // เก็บชื่อไฟล์ไว้ใน user_data
            char *name_copy = strdup(fno.fname);
            lv_obj_set_user_data(btn, name_copy);
            lv_obj_add_event_cb(btn, _playlist_item_click_cb, LV_EVENT_CLICKED, target_video);

            // เลย์เอาต์ภายในปุ่ม (ไอคอน + ชื่อไฟล์ + ขนาด)
            lv_obj_set_flex_flow(btn, LV_FLEX_FLOW_ROW);
            lv_obj_set_flex_align(btn, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

            lv_obj_t *icon = lv_label_create(btn);
            lv_label_set_text(icon, LV_SYMBOL_VIDEO);
            lv_obj_set_style_text_color(icon, is_cur ? lv_color_white() : lv_color_hex(0x94A3B8), 0);

            lv_obj_t *label_name = lv_label_create(btn);
            lv_label_set_text(label_name, fno.fname);
            lv_label_set_long_mode(label_name, LV_LABEL_LONG_DOT);
            lv_obj_set_flex_grow(label_name, 1);
            lv_obj_set_style_text_color(label_name, lv_color_white(), 0);
            lv_obj_set_style_text_font(label_name, &anuphan_14, 0);

            char size_str[16];
            _format_size_str((size_t)fno.fsize, size_str, sizeof(size_str));
            lv_obj_t *label_sz = lv_label_create(btn);
            lv_label_set_text(label_sz, size_str);
            lv_obj_set_style_text_color(label_sz, is_cur ? lv_color_hex(0xE2E8F0) : lv_color_hex(0x64748B), 0);
            lv_obj_set_style_text_font(label_sz, &anuphan_14, 0);
        }
    }
    f_closedir(&dir);

    if (count == 0) {
        lv_obj_t *empty_label = lv_label_create(list);
        lv_label_set_text(empty_label, "ไม่พบไฟล์ .avi ใน SD Card");
        lv_obj_set_style_text_color(empty_label, lv_color_hex(0x64748B), 0);
        lv_obj_set_style_text_font(empty_label, &anuphan_14, 0);
        lv_obj_center(empty_label);
    }
}

/* Event ปิดแถบ Playlist */
static void _playlist_close_btn_cb(lv_event_t *e) {
    lv_obj_add_flag(s_playlist_panel, LV_OBJ_FLAG_HIDDEN);
}

/* ฟังก์ชันสร้าง Drawer แสดง Playlist วิดีโอ */
static void create_playlist_panel(lv_obj_t *parent, lv_obj_t *target_video) {
    // 1. กล่องพื้นหลังแบบลอยตัว อยู่ชิดขวา
    s_playlist_panel = lv_obj_create(parent);
    lv_obj_set_size(s_playlist_panel, 330, 480);
    lv_obj_align(s_playlist_panel, LV_ALIGN_TOP_RIGHT, -16, 20);
    lv_obj_set_style_bg_color(s_playlist_panel, lv_color_hex(0x0F172A), 0);
    lv_obj_set_style_bg_opa(s_playlist_panel, LV_OPA_90, 0);
    lv_obj_set_style_border_color(s_playlist_panel, lv_color_hex(0x334155), 0);
    lv_obj_set_style_border_width(s_playlist_panel, 1, 0);
    lv_obj_set_style_radius(s_playlist_panel, 16, 0);
    lv_obj_set_style_pad_all(s_playlist_panel, 12, 0);
    lv_obj_set_scrollable(s_playlist_panel, false);
    lv_obj_add_flag(s_playlist_panel, LV_OBJ_FLAG_HIDDEN); // ซ่อนไว้เริ่มต้น

    // 2. Header ของ Playlist (ชื่อหัวข้อ + ปุ่มปิด X)
    lv_obj_t *header = lv_obj_create(s_playlist_panel);
    lv_obj_set_size(header, lv_pct(100), 40);
    lv_obj_set_style_bg_opa(header, LV_OPA_TRANSP, 0);
    lv_obj_set_style_border_width(header, 0, 0);
    lv_obj_set_style_pad_all(header, 0, 0);
    lv_obj_set_scrollable(header, false);
    lv_obj_set_flex_flow(header, LV_FLEX_FLOW_ROW);
    lv_obj_set_flex_align(header, LV_FLEX_ALIGN_SPACE_BETWEEN, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

    lv_obj_t *title = lv_label_create(header);
    lv_label_set_text(title, "รายการวิดีโอ (SD Card)");
    lv_obj_set_style_text_color(title, lv_color_white(), 0);
    lv_obj_set_style_text_font(title, &anuphan_semi_bold_16, 0);

    lv_obj_t *close_btn = lv_button_create(header);
    lv_obj_set_size(close_btn, 32, 32);
    lv_obj_set_style_radius(close_btn, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_bg_color(close_btn, lv_color_hex(0x334155), 0);
    lv_obj_set_style_shadow_width(close_btn, 0, 0);
    lv_obj_add_event_cb(close_btn, _playlist_close_btn_cb, LV_EVENT_CLICKED, NULL);

    lv_obj_t *close_txt = lv_label_create(close_btn);
    lv_label_set_text(close_txt, LV_SYMBOL_CLOSE);
    lv_obj_set_style_text_color(close_txt, lv_color_white(), 0);
    lv_obj_center(close_txt);

    // 3. คอนเทนเนอร์รายการแบบเลื่อนได้ (Scrollable List Container)
    s_playlist_list = lv_obj_create(s_playlist_panel);
    lv_obj_set_size(s_playlist_list, lv_pct(100), 410);
    lv_obj_align(s_playlist_list, LV_ALIGN_BOTTOM_MID, 0, 0);
    lv_obj_set_style_bg_opa(s_playlist_list, LV_OPA_TRANSP, 0);
    lv_obj_set_style_border_width(s_playlist_list, 0, 0);
    lv_obj_set_style_pad_all(s_playlist_list, 0, 0);
    lv_obj_set_flex_flow(s_playlist_list, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_row(s_playlist_list, 6, 0); // ระยะห่างแต่ละแถว
}

/* Callback สลับเปิด/ปิดแผง Playlist */
static void _playlist_toggle_btn_cb(lv_event_t *e) {
    lv_obj_t *target_video = (lv_obj_t *)lv_event_get_user_data(e);
    if (!s_playlist_panel) return;

    if (lv_obj_has_flag(s_playlist_panel, LV_OBJ_FLAG_HIDDEN)) {
        // อัปเดตรายการไฟล์ล่าสุดจาก SD Card ก่อนแสดงผล
        _populate_avi_playlist(s_playlist_list, target_video);
        lv_obj_remove_flag(s_playlist_panel, LV_OBJ_FLAG_HIDDEN);
        lv_obj_move_foreground(s_playlist_panel);
    } else {
        lv_obj_add_flag(s_playlist_panel, LV_OBJ_FLAG_HIDDEN);
    }
}

/* 1.1 ตั้งค่าฮาร์ดแวร์ I2S สำหรับส่งสัญญาณเสียงเข้า ES8311 */
static void init_audio_hardware(void) {
    // 3. ติดตั้งไดรเวอร์ I2S TX Channel
    i2s_chan_config_t chan_cfg = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
    chan_cfg.auto_clear = true; // ส่งค่าความเงียบอัตโนมัติเมื่อ Buffer ว่าง ป้องกันเสียงจี่/ค้าง
    ESP_ERROR_CHECK(i2s_new_channel(&chan_cfg, &s_i2s_tx_chan, NULL));

    i2s_std_config_t std_cfg = {
        .clk_cfg = {
            .sample_rate_hz = 44100, // ค่าเริ่มต้น
            .clk_src = I2S_CLK_SRC_DEFAULT,
            .ext_clk_freq_hz = 0,
            .mclk_multiple = I2S_MCLK_MULTIPLE_256, // ES8311 ต้องการ MCLK = 256 * Fs
        },
        .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO),
        .gpio_cfg = {
            .mclk = I2S_MCLK_IO, // GPIO 13
            .bclk = I2S_BCLK_IO, // GPIO 12
            .ws   = I2S_WS_IO,   // GPIO 10
            .dout = I2S_DOUT_IO, // GPIO 9
            .din  = GPIO_NUM_NC,
            .invert_flags = {0},
        },
    };

    ESP_ERROR_CHECK(i2s_channel_init_std_mode(s_i2s_tx_chan, &std_cfg));
    ESP_ERROR_CHECK(i2s_channel_enable(s_i2s_tx_chan));
    s_current_audio_rate = 44100;

    // 2. ตั้งค่าชิป DAC ES8311 ผ่านบัส I2C
    es8311_codec_init(i2c_bus_handle);

gpio_config_t io_conf = {
        .pin_bit_mask = (1ULL << PA_ENABLE_GPIO),
        .mode = GPIO_MODE_OUTPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
    };
    gpio_config(&io_conf);
    gpio_set_level(PA_ENABLE_GPIO, 1); // สั่ง High เพื่อเปิดวงจรขยายเสียง
}

/* 1.2 สลับ Sample Rate ของบัส I2S อัตโนมัติตามข้อมูลจริงในไฟล์ AVI */
static void reconfig_i2s_rate_if_needed(uint32_t rate) {
    if (rate > 0 && rate != s_current_audio_rate && s_i2s_tx_chan) {
        i2s_std_clk_config_t clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(rate);
        clk_cfg.mclk_multiple = I2S_MCLK_MULTIPLE_256;
        i2s_channel_disable(s_i2s_tx_chan);
        i2s_channel_reconfig_std_clock(s_i2s_tx_chan, &clk_cfg);
        i2s_channel_enable(s_i2s_tx_chan);
        s_current_audio_rate = rate;
        ESP_LOGI("AUDIO", "Switched I2S Sample Rate to: %lu Hz", rate);
    }
}
HMP3Decoder mp3_dec;
#define AUDIO_ACCUM_BUF_SIZE (16 * 1024) // ขยายเป็น 16 KB กันตกหล่น

static void audio_player_task(void *pvParam) {
    HMP3Decoder mp3_dec = MP3InitDecoder();
    if (!mp3_dec) {
        ESP_LOGE("AUDIO", "MP3InitDecoder failed");
        vTaskDelete(NULL);
        return;
    }

    int16_t *pcm_out = (int16_t *)malloc(1152 * 2 * sizeof(int16_t));
    uint8_t *accum_buf = (uint8_t *)malloc(AUDIO_ACCUM_BUF_SIZE);
    int accum_bytes = 0;
    MP3FrameInfo frame_info;

    uint32_t current_sample_rate = 0;
    
    // ตัวแปรเก็บสถิติสำหรับ Debug
    uint32_t frames_decoded = 0;
    uint32_t underflow_cnt = 0;
    uint32_t err_header_cnt = 0;
    uint32_t accum_overflow_cnt = 0;
    int64_t last_log_time = esp_timer_get_time();

    while (1) {
        // --- 1. สรุปผล Diagnostic ทุก 1 วินาที ---
        /*
        int64_t now = esp_timer_get_time();
        if (now - last_log_time >= 1000000) {
            size_t rb_free = xRingbufferGetCurFreeSize(s_audio_ringbuf);
            ESP_LOGI("AUDIO_DIAG", 
                     "In: %lu chk (%lu B) | Drop: %lu | Decoded: %lu fps | Underflow: %lu | BadHdr: %lu | AccumOvf: %lu | RB Free: %u B",
                     s_stat_audio_in_chunks, s_stat_audio_in_bytes, s_stat_audio_dropped_chunks,
                     frames_decoded, underflow_cnt, err_header_cnt, accum_overflow_cnt, (unsigned)rb_free);

            // รีเซ็ตตัวนับรอบวินาที
            s_stat_audio_in_chunks = 0;
            s_stat_audio_in_bytes = 0;
            frames_decoded = 0;
            underflow_cnt = 0;
            err_header_cnt = 0;
            accum_overflow_cnt = 0;
            last_log_time = now;
        }*/

        if (s_audio_flush) {
            accum_bytes = 0;
            s_audio_flush = false;
        }

        size_t item_size = 0;
        // รอรับ Chunk จาก RingBuffer สูงสุด 20ms
        uint8_t *chunk = (uint8_t *)xRingbufferReceive(s_audio_ringbuf, &item_size, pdMS_TO_TICKS(20));
        
        if (chunk) {
            if (accum_bytes + item_size <= AUDIO_ACCUM_BUF_SIZE) {
                memcpy(accum_buf + accum_bytes, chunk, item_size);
                accum_bytes += item_size;
            } else {
                accum_overflow_cnt++;
                accum_bytes = 0; // เผื่อกรณีค้างหนัก
            }
            vRingbufferReturnItem(s_audio_ringbuf, (void *)chunk);
        }

        if (accum_bytes == 0) {
            continue;
        }

        int bytes_left = accum_bytes;
        unsigned char *read_ptr = accum_buf;

        // --- 2. ลูปถอดรหัส ---
        while (bytes_left > 0) {
            int offset = MP3FindSyncWord(read_ptr, bytes_left);
            if (offset < 0) {
                bytes_left = 0;
                break;
            }

            read_ptr += offset;
            bytes_left -= offset;

            int err = MP3Decode(mp3_dec, &read_ptr, &bytes_left, pcm_out, 0);
            
            if (err == ERR_MP3_NONE) {
                frames_decoded++;
                MP3GetLastFrameInfo(mp3_dec, &frame_info);

                if (frame_info.samprate > 0 && frame_info.samprate != current_sample_rate) {
                    current_sample_rate = frame_info.samprate;
                    i2s_std_clk_config_t clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(current_sample_rate);
                    clk_cfg.mclk_multiple = I2S_MCLK_MULTIPLE_256;
                    i2s_channel_disable(s_i2s_tx_chan);
                    i2s_channel_reconfig_std_clock(s_i2s_tx_chan, &clk_cfg);
                    i2s_channel_enable(s_i2s_tx_chan);
                }

                size_t pcm_bytes = 0;
                if (frame_info.nChans == 1) {
                    short stereo_temp[1152 * 2];
                    for (int i = 0; i < frame_info.outputSamps; i++) {
                        stereo_temp[i * 2]     = pcm_out[i];
                        stereo_temp[i * 2 + 1] = pcm_out[i];
                    }
                    pcm_bytes = frame_info.outputSamps * 2 * sizeof(int16_t);
                    size_t written = 0;
                    i2s_channel_write(s_i2s_tx_chan, stereo_temp, pcm_bytes, &written, portMAX_DELAY);
                } else {
                    pcm_bytes = frame_info.outputSamps * sizeof(int16_t);
                    size_t written = 0;
                    i2s_channel_write(s_i2s_tx_chan, pcm_out, pcm_bytes, &written, portMAX_DELAY);
                }
            } 
            else if (err == ERR_MP3_INDATA_UNDERFLOW) {
                underflow_cnt++;
                break; // รอข้อมูล Chunk ถัดไปมาประกอบ
            } 
            else {
                err_header_cnt++;
                if (bytes_left > 0) {
                    read_ptr++;
                    bytes_left--;
                }
            }
        }

        // เก็บเศษไบต์ที่ถอดไม่หมดไว้ที่ต้นบัฟเฟอร์
        if (bytes_left > 0 && read_ptr != accum_buf) {
            memmove(accum_buf, read_ptr, bytes_left);
        }
        accum_bytes = bytes_left;
    }

    MP3FreeDecoder(mp3_dec);
    free(accum_buf);
    free(pcm_out);
    vTaskDelete(NULL);
}

static void on_avi_audio_chunk(const uint8_t *data, size_t len, void *user_ctx) {
    // ส่งเข้า RingBuffer ตามปกติ
    if (s_audio_ringbuf && data && len > 0) {
        xRingbufferSend(s_audio_ringbuf, data, len, 0);
    }
}

/* แปลงวินาทีเป็นข้อความ MM:SS หรือ HH:MM:SS */
static void _format_time_sec(uint32_t sec, char *buf, size_t buf_sz) {
    unsigned int h = (unsigned int)(sec / 3600);
    unsigned int m = (unsigned int)((sec % 3600) / 60);
    unsigned int s = (unsigned int)(sec % 60);

    if (h > 0) {
        snprintf(buf, buf_sz, "%02u:%02u:%02u", h, m, s);
    } else {
        snprintf(buf, buf_sz, "%02u:%02u", m, s);
    }
}

/* Event เมื่อกดหรือลาก Slider */
static void _video_slider_event_cb(lv_event_t *e) {
    lv_event_code_t code = lv_event_get_code(e);
    lv_obj_t *slider_obj = lv_event_get_target(e);
    lv_obj_t *target_video = (lv_obj_t *)lv_event_get_user_data(e);

    if (code == LV_EVENT_PRESSED) {
        s_is_scrubbing = true; // เริ่มลาก: หยุดการ Sync ตำแหน่งชั่วคราว
    } 
    else if (code == LV_EVENT_VALUE_CHANGED) {
        // อัปเดตตัวเลขเวลาตามนิ้วที่ลากทันที
        uint32_t seek_val = (uint32_t)lv_slider_get_value(slider_obj);
        uint32_t tot_sec  = vd_avi_get_total_sec(target_video);

        char cur_str[16], tot_str[16];
        _format_time_sec(seek_val, cur_str, sizeof(cur_str));
        _format_time_sec(tot_sec, tot_str, sizeof(tot_str));
        lv_label_set_text_fmt(s_slider_time, "%s / %s", cur_str, tot_str);
    } 
    else if (code == LV_EVENT_RELEASED || code == LV_EVENT_PRESS_LOST) {
        // ปล่อยมือ: สั่ง Seek วิดีโอไปยังวินาทีที่ปล่อย
        uint32_t target_sec = (uint32_t)lv_slider_get_value(slider_obj);
        vd_avi_seek(target_video, target_sec);

        vTaskDelay(pdMS_TO_TICKS(50));

        if (s_audio_ringbuf) {
    size_t dummy_sz = 0;
    while (xRingbufferReceive(s_audio_ringbuf, &dummy_sz, 0)) {
        // ดึงทิ้งจนเกลี้ยงบัฟเฟอร์
    }
  }
  s_audio_flush      = true;

        s_is_scrubbing = false;
        uint32_t sec = vd_avi_get_current_sec(target_video);
        ESP_LOGI(TAG, "Set seek to %lus", sec);
    }
}

/* Event เมื่อกดปุ่ม Play / Pause */
static void _play_pause_btn_cb(lv_event_t *e) {
    lv_obj_t *target_video = (lv_obj_t *)lv_event_get_user_data(e);
    if (!target_video) return;

    if (vd_avi_is_playing(target_video)) {
        vd_avi_pause(target_video);
        lv_label_set_text(s_play_pause_txt, LV_SYMBOL_PLAY);
    } else {
        vd_avi_play(target_video);
        lv_label_set_text(s_play_pause_txt, LV_SYMBOL_PAUSE);
    }
}

/* Timer สำหรับอัปเดตตำแหน่ง Slider และเวลาแบบ Real-time ทุกๆ 250 ms */
static void _video_sync_timer_cb(lv_timer_t *t) {
    lv_obj_t *target_video = (lv_obj_t *)lv_timer_get_user_data(t);
    if (!target_video || !lv_obj_is_valid(target_video)) return;

    uint32_t tot_sec = vd_avi_get_total_sec(target_video);
    uint32_t cur_sec = vd_avi_get_current_sec(target_video);

    // อัปเดตไอคอนปุ่มให้ตรงตามสถานะการเล่นจริง
    bool is_play = vd_avi_is_playing(target_video);
    lv_label_set_text(s_play_pause_txt, is_play ? LV_SYMBOL_PAUSE : LV_SYMBOL_PLAY);

    // หากกำลังใช้นิ้วลาก Slider อยู่ ไม่ให้อัปเดตตำแหน่งทับ
    if (!s_is_scrubbing && s_slider) {
        lv_slider_set_range(s_slider, 0, (int32_t)tot_sec);
        lv_slider_set_value(s_slider, (int32_t)cur_sec, LV_ANIM_OFF);

        char cur_str[16], tot_str[16];
        _format_time_sec(cur_sec, cur_str, sizeof(cur_str));
        _format_time_sec(tot_sec, tot_str, sizeof(tot_str));
        lv_label_set_text_fmt(s_slider_time, "%s / %s", cur_str, tot_str);
    }
}

static lv_obj_t *s_vol_slider     = NULL;
static lv_obj_t *s_vol_btn        = NULL;
static lv_obj_t *s_vol_txt        = NULL;
static bool      s_is_muted       = false;
static uint8_t   s_last_volume    = 80; // ระดับเสียงเริ่มต้น 80%

/* Callback เมื่อเลื่อน Slider ปรับความดังเสียง */
static void _volume_slider_event_cb(lv_event_t *e) {
    lv_obj_t *slider_obj = lv_event_get_target(e);
    int32_t val = lv_slider_get_value(slider_obj);

    if (val <= 0) {
        val = 0;
        s_is_muted = true;
        es8311_set_mute(true);
        lv_label_set_text(s_vol_txt, LV_SYMBOL_MUTE);
    } else {
        if (s_is_muted) {
            es8311_set_mute(false);
            s_is_muted = false;
        }
        s_last_volume = (uint8_t)val;
        es8311_set_volume(s_last_volume);
        lv_label_set_text(s_vol_txt, (val > 50) ? LV_SYMBOL_VOLUME_MAX : LV_SYMBOL_VOLUME_MID);
    }
}

/* Callback เมื่อแตะไอคอนลำโพงเพื่อสลับ Mute / Unmute */
static void _vol_mute_btn_cb(lv_event_t *e) {
    s_is_muted = !s_is_muted;

    if (s_is_muted) {
        es8311_set_mute(true);
        lv_slider_set_value(s_vol_slider, 0, LV_ANIM_ON);
        lv_label_set_text(s_vol_txt, LV_SYMBOL_MUTE);
    } else {
        es8311_set_mute(false);
        if (s_last_volume == 0) s_last_volume = 50;
        es8311_set_volume(s_last_volume);
        lv_slider_set_value(s_vol_slider, (int32_t)s_last_volume, LV_ANIM_ON);
        lv_label_set_text(s_vol_txt, (s_last_volume > 50) ? LV_SYMBOL_VOLUME_MAX : LV_SYMBOL_VOLUME_MID);
    }
}

/* ฟังก์ชันสร้าง Control Bar */
static void create_video_controls(lv_obj_t *parent, lv_obj_t *target_video) {
    if (!parent || !target_video) return;

    // 1. แถบพื้นหลังลอย (Floating Bar) ด้านล่างจอ กว้าง 860 px
    s_ctrl_bar = lv_obj_create(parent);
    lv_obj_set_size(s_ctrl_bar, 860, 56);
    lv_obj_align(s_ctrl_bar, LV_ALIGN_BOTTOM_MID, 0, -20);
    lv_obj_set_style_bg_color(s_ctrl_bar, lv_color_hex(0x0F172A), 0);
    lv_obj_set_style_bg_opa(s_ctrl_bar, LV_OPA_80, 0); // โปร่งแสง 80%
    lv_obj_set_style_border_color(s_ctrl_bar, lv_color_hex(0x334155), 0);
    lv_obj_set_style_border_width(s_ctrl_bar, 1, 0);
    lv_obj_set_style_radius(s_ctrl_bar, 28, 0); // ทรงแคปซูลมน
    lv_obj_set_style_pad_hor(s_ctrl_bar, 16, 0);
    lv_obj_set_style_pad_ver(s_ctrl_bar, 0, 0);
    lv_obj_set_scrollable(s_ctrl_bar, false);
    lv_obj_set_flex_flow(s_ctrl_bar, LV_FLEX_FLOW_ROW);
    lv_obj_set_flex_align(s_ctrl_bar, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

    // 2. ปุ่ม Play / Pause
    s_play_pause_btn = lv_button_create(s_ctrl_bar);
    lv_obj_set_size(s_play_pause_btn, 40, 40);
    lv_obj_set_style_radius(s_play_pause_btn, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_bg_color(s_play_pause_btn, lv_color_hex(0x5B6EF5), 0);
    lv_obj_set_style_shadow_width(s_play_pause_btn, 0, 0);
    lv_obj_set_style_shadow_width(s_play_pause_btn, 0, 0);
    lv_obj_set_ext_click_area(s_play_pause_btn, 20);
    lv_obj_add_event_cb(s_play_pause_btn, _play_pause_btn_cb, LV_EVENT_CLICKED, target_video);

    s_play_pause_txt = lv_label_create(s_play_pause_btn);
    lv_label_set_text(s_play_pause_txt, LV_SYMBOL_PAUSE);
    lv_obj_set_style_text_color(s_play_pause_txt, lv_color_white(), 0);
    lv_obj_center(s_play_pause_txt);

    // 3. ตัวลากความคืบหน้า (Scrubber Slider)
    s_slider = lv_slider_create(s_ctrl_bar);
    lv_obj_set_flex_grow(s_slider, 1); // ยืดความกว้างให้เต็มพื้นที่ส่วนกลาง
    lv_obj_set_height(s_slider, 10);
    lv_slider_set_range(s_slider, 0, 100);
    lv_obj_set_style_bg_color(s_slider, lv_color_hex(0x334155), LV_PART_MAIN);
    lv_obj_set_style_bg_color(s_slider, lv_color_hex(0x5B6EF5), LV_PART_INDICATOR);
    lv_obj_set_style_bg_color(s_slider, lv_color_white(), LV_PART_KNOB);
    lv_obj_set_style_pad_all(s_slider, 5, LV_PART_KNOB); // ขนาดหัวลาก
    lv_obj_set_ext_click_area(s_slider, 10);
    lv_obj_add_event_cb(s_slider, _video_slider_event_cb, LV_EVENT_ALL, target_video);

    // 4. ข้อความแสดงเวลา (MM:SS / MM:SS)
    s_slider_time = lv_label_create(s_ctrl_bar);
    lv_label_set_text(s_slider_time, "00:00 / 00:00");
    lv_obj_set_style_text_color(s_slider_time, lv_color_hex(0xCBD5E1), 0);
    lv_obj_set_style_text_font(s_slider_time, &anuphan_14, 0);
    lv_obj_set_style_pad_left(s_slider_time, 12, 0);

    // 5. ผูก Timer วนอ่านค่าเวลาเพื่ออัปเดตแถบ UI
    s_video_sync_timer = lv_timer_create(_video_sync_timer_cb, 250, target_video);

    // 5. ปุ่มไอคอน Mute / Unmute
    s_vol_btn = lv_button_create(s_ctrl_bar);
    lv_obj_set_size(s_vol_btn, 36, 36);
    lv_obj_set_style_radius(s_vol_btn, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_bg_opa(s_vol_btn, LV_OPA_TRANSP, 0);
    lv_obj_set_style_shadow_width(s_vol_btn, 0, 0);
    lv_obj_set_ext_click_area(s_vol_btn, 10);
    lv_obj_add_event_cb(s_vol_btn, _vol_mute_btn_cb, LV_EVENT_CLICKED, NULL);

    s_vol_txt = lv_label_create(s_vol_btn);
    lv_label_set_text(s_vol_txt, LV_SYMBOL_VOLUME_MAX);
    lv_obj_set_style_text_color(s_vol_txt, lv_color_hex(0x94A3B8), 0);
    lv_obj_center(s_vol_txt);

    // 6. แถบลากปรับความดังเสียง (Volume Slider) กว้าง 90 px
    s_vol_slider = lv_slider_create(s_ctrl_bar);
    lv_obj_set_size(s_vol_slider, 90, 6);
    lv_slider_set_range(s_vol_slider, 0, 110);
    lv_slider_set_value(s_vol_slider, (int32_t)s_last_volume, LV_ANIM_OFF);
    lv_obj_set_style_bg_color(s_vol_slider, lv_color_hex(0x334155), LV_PART_MAIN);
    lv_obj_set_style_bg_color(s_vol_slider, lv_color_hex(0x10B981), LV_PART_INDICATOR); // สีเขียวมิ้นต์แยกจากแถบวิดีโอ
    lv_obj_set_style_bg_color(s_vol_slider, lv_color_white(), LV_PART_KNOB);
    lv_obj_set_style_pad_all(s_vol_slider, 3, LV_PART_KNOB);
    lv_obj_set_ext_click_area(s_vol_slider, 12);
    lv_obj_add_event_cb(s_vol_slider, _volume_slider_event_cb, LV_EVENT_VALUE_CHANGED, NULL);

    // ตั้งระดับเสียงเริ่มต้น 80% ให้ฮาร์ดแวร์
    es8311_set_volume(s_last_volume);

    // 7. ผูก Timer ซิงก์เวลาวิดีโอ 250ms
    s_video_sync_timer = lv_timer_create(_video_sync_timer_cb, 250, target_video);

    // 7. ปุ่มเปิดรายการวิดีโอ (Playlist Button)
    lv_obj_t *s_playlist_btn = lv_button_create(s_ctrl_bar);
    lv_obj_set_size(s_playlist_btn, 40, 40);
    lv_obj_set_style_radius(s_playlist_btn, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_bg_color(s_playlist_btn, lv_color_hex(0x334155), 0);
    lv_obj_set_style_shadow_width(s_playlist_btn, 0, 0);
    lv_obj_set_ext_click_area(s_playlist_btn, 12);
    lv_obj_add_event_cb(s_playlist_btn, _playlist_toggle_btn_cb, LV_EVENT_CLICKED, target_video);

    lv_obj_t *playlist_txt = lv_label_create(s_playlist_btn);
    lv_label_set_text(playlist_txt, LV_SYMBOL_LIST);
    lv_obj_set_style_text_color(playlist_txt, lv_color_white(), 0);
    lv_obj_center(playlist_txt);

    // สร้างแผง Playlist ซ้อนไว้บนหน้าจอ
    create_playlist_panel(parent, target_video);
}

#define VD_MSP_SANDBOX_DIRECT_SERVER_URL      "https://stage.moneysp.net/"
#define VD_MSP_SANDBOX_REDIRECT_SERVER_URL    "https://stage-a.moneysp.net/"
#define VD_MSP_PRODUCTION_DIRECT_SERVER_URL   "https://moneyspace.net/"
#define VD_MSP_PRODUCTION_REDIRECT_SERVER_URL "https://a.moneyspace.net/"

#define VD_MSP_ORDER_STATUS_PENDING_STR "Pending"
#define VD_MSP_ORDER_STATUS_SUCCESS_STR "Pay Success"
#define VD_MSP_ORDER_STATUS_FAIL_STR    "Fail"
#define VD_MSP_ORDER_STATUS_CANCEL_STR  "Cancel"
#define VD_MSP_ORDER_STATUS_EXPIRED_STR "Expired"
#define VD_MSP_ORDER_STATUS_ERROR_STR   "error"

typedef enum vd_msp_order_status_t {
  VD_MSP_ORDER_STATUS_PENDING,
  VD_MSP_ORDER_STATUS_SUCCESS,
  VD_MSP_ORDER_STATUS_FAIL,
  VD_MSP_ORDER_STATUS_CANCEL,
  VD_MSP_ORDER_STATUS_EXPIRED,
  VD_MSP_ORDER_STATUS_ERROR
} vd_msp_order_status_t;

/*
Create:
[
  {
    "status": "success",
    "transaction_ID": "txn_123456789",
    "image_qrprom": "https://example.com/qr.png"
  }
]

[
  {
    "status": "Have duplicate order number."
  }
]

Get status:
[
  {
    "order id": {
      "status": "success",
      "amount": 100.11,
      "description": "Order has been completed"
    }
  }
]

[
  {
    "status": "error",
    "description": "NotFound"
  }
]
*/

typedef enum vd_msp_err_t {
  VD_MSP_OK,
  VD_MSP_ERR_INVALID_PARAM,
  VD_MSP_ERR_NO_MEM,
  VD_MSP_ERR_HTTP,
  VD_MSP_ERR_JSON,
  VD_MSP_ERR_API,
  VD_MSP_ERR_NODATA,
} vd_msp_err_t;

typedef struct vd_msp_promptpay_gateway_t {
  http_req_t *http;

  const char *secret_id; // required
  const char *secret_key; // required
  
  char order_id[20]; // required, Must be unique, alphanumeric only, max 20 chars
  char *firstname; // Shopper's first name
  char *lastname; // Shopper's last name
  char *email;  // Shopper's email for receipt
  char *phone; // Shopper's mobile phone number
  double amount; // required, Must be 2 decimal places and use dot (.) as decimal separator
  char *description; // Product/service details
  char *address;
  char *message; // Note to the seller

  // doc บอกว่า required แต่จริงๆ ไม่ใส่ก็ไม่ error
  char *success_url; // required
  char *fail_url; // required
  char *cancel_url; // required

  char agreement[200]; // One of [1,2,3,4,5] or any agreement text (max 200 characters)
  char branch[128]; // Shopper's branch name
  char device_id[32]; // Shopper's device ID
  
  char *ref1; // Shopper's ref 1
  char *ref2; // Shopper's ref 2
  char *ref3; // Shopper's ref 3
  char *ref4; // Shopper's ref 4
  char *ref5; // Shopper's ref 5

  //char *language; // Default is th, accepts en or th

  char *transaction_id;
  char *qr_url;

  bool transaction_created;
} vd_msp_promptpay_gateway_t;

/**
 * @brief ดึงค่า double จาก cJSON (รองรับทั้งกรณีส่งมาเป็นตัวเลข 1.50 หรือข้อความ "1.50")
 * @param item cJSON element ของคีย์นั้นๆ
 * @param default_val ค่าดีฟอลต์กรณีหาไม่เจอหรือแปลงไม่ผ่าน
 * @return ค่า double ที่แปลงได้
 */
double cjson_get_double(const cJSON *item, double default_val) {
    if (!item) return default_val;

    // กรณีที่ 1: ส่งมาเป็นตัวเลขแท้ 1.50
    if (cJSON_IsNumber(item)) {
        return item->valuedouble;
    }

    // กรณีที่ 2: ส่งมาเป็นสตริง "1.50"
    if (cJSON_IsString(item) && item->valuestring) {
        char *endptr = NULL;
        double val = strtod(item->valuestring, &endptr);

        // endptr != item->valuestring แสดงว่ามีการแปลงตัวเลขสำเร็จอย่างน้อย 1 ตัว
        if (endptr != item->valuestring) {
            return val;
        }
    }

    return default_val;
}

vd_msp_promptpay_gateway_t *vd_msp_promptpay_gateway_init(const char *secret_id, const char *secret_key, const char *agreement) {
    if (!secret_id || !secret_key || !agreement) return NULL;

    vd_msp_promptpay_gateway_t *gw = (vd_msp_promptpay_gateway_t *)calloc(1, sizeof(vd_msp_promptpay_gateway_t));
    if (!gw) {
        ESP_LOGE(TAG, "Can't allocate memory for vd_msp_promptpay_gateway_t");
        return NULL;
    }

    gw->secret_id  = secret_id;
    gw->secret_key = secret_key;
    
    // คัดลอกอย่างปลอดภัยไม่เกินขนาดของ gw->agreement
    strncpy(gw->agreement, agreement, sizeof(gw->agreement) - 1);
    gw->agreement[sizeof(gw->agreement) - 1] = '\0';

    gw->http = NULL;
    return gw;
}

vd_msp_err_t vd_msp_promptpay_gateway_set_amount(vd_msp_promptpay_gateway_t *gw, double value){
  if(!gw || value < 0.10 || value > 10000.0 || gw->transaction_created) return VD_MSP_ERR_INVALID_PARAM;

  gw->amount = value;

  return VD_MSP_OK;
}

vd_msp_err_t vd_msp_promptpay_gateway_set_order_id(vd_msp_promptpay_gateway_t *gw, const char *order_id) {
    if (!gw || !order_id || gw->transaction_created) return VD_MSP_ERR_INVALID_PARAM;

    strncpy(gw->order_id, order_id, sizeof(gw->order_id) - 1);
    gw->order_id[sizeof(gw->order_id) - 1] = '\0';

    return VD_MSP_OK;
}

vd_msp_err_t vd_msp_promptpay_gateway_set_device_id(vd_msp_promptpay_gateway_t *gw, const char *device_id) {
    if (!gw || !device_id || gw->transaction_created) return VD_MSP_ERR_INVALID_PARAM;

    strncpy(gw->device_id, device_id, sizeof(gw->device_id) - 1);
    gw->device_id[sizeof(gw->device_id) - 1] = '\0';

    return VD_MSP_OK;
}

vd_msp_err_t vd_msp_promptpay_gateway_create_transaction(vd_msp_promptpay_gateway_t *gw){
  if(!gw || !strlen(gw->order_id) || gw->transaction_created) return VD_MSP_ERR_INVALID_PARAM;

  gw->http = http_open(VD_MSP_PRODUCTION_REDIRECT_SERVER_URL "payment/CreateTransaction", HTTP_METHOD_POST);
  if(!gw->http){
    ESP_LOGI(TAG, "Can't allocate memory for http");
    return VD_MSP_ERR_NO_MEM;
  }

  vd_msp_err_t gw_err = VD_MSP_OK;
  char amount_str[20];
  sprintf(amount_str, "%.2f", gw->amount);

  gw->qr_url = NULL;

  cJSON *root = cJSON_CreateObject();
  cJSON_AddStringToObject(root, "secret_id", gw->secret_id);
  cJSON_AddStringToObject(root, "secret_key", gw->secret_key);
  cJSON_AddStringToObject(root, "order_id", gw->order_id);
  cJSON_AddRawToObject(root, "amount", amount_str);
  cJSON_AddStringToObject(root, "feeType", "include");
  cJSON_AddStringToObject(root, "payment_type", "qrnone");
  cJSON_AddStringToObject(root, "agreement", gw->agreement);
  cJSON_AddStringToObject(root, "device_id", gw->device_id);
  cJSON_AddStringToObject(root, "language", "th");

  char *body = cJSON_PrintUnformatted(root);

  http_set_header(gw->http, "Content-Type", "application/json");
  http_set_body(gw->http, body);
  http_set_resp_opt(gw->http, false, true);
  
  const char *res = http_send(gw->http);
  if(!res){
    ESP_LOGI(TAG, "Send request fail");
    cJSON_Delete(root);
    free(body);
    http_close(gw->http);
    gw->http = NULL;

    return VD_MSP_ERR_HTTP;
  }

  uint16_t http_code = http_get_code(gw->http);
  if(http_code != 200){
    ESP_LOGI(TAG, "API request fail, Code = %d", (int)http_code);
    cJSON_Delete(root);
    free(body);
    http_close(gw->http);
    gw->http = NULL;

    return VD_MSP_ERR_API;
  }

  cJSON_Delete(root);
  root = NULL;

  free(body);

  root = cJSON_Parse(res);
  if(!root) {
    gw_err = VD_MSP_ERR_JSON;
    goto api_err_exit;
  }

  if (!cJSON_IsArray(root)) {
    ESP_LOGE(TAG, "Expected JSON Array at root");
    gw_err = VD_MSP_ERR_JSON;
    goto api_err_exit;
  }

  cJSON *item = cJSON_GetArrayItem(root, 0);
  if (!item || !cJSON_IsObject(item)) {
    ESP_LOGE(TAG, "Item[0] is not a valid JSON Object");
    gw_err = VD_MSP_ERR_JSON;
    goto api_err_exit;
  }

  cJSON *status = cJSON_GetObjectItemCaseSensitive(item, "status");
  if (cJSON_IsString(status) && status->valuestring) {
    if(strcmp(status->valuestring, "success") != 0) {
      ESP_LOGE(TAG, "API Error: status = %s", status->valuestring);
      gw_err = VD_MSP_ERR_API;
      goto api_err_exit;
    }

    cJSON *tx_id  = cJSON_GetObjectItemCaseSensitive(item, "transaction_ID");
    cJSON *qr_url = cJSON_GetObjectItemCaseSensitive(item, "image_qrprom");

    if (!tx_id->valuestring || !cJSON_IsString(tx_id)) {
      ESP_LOGE(TAG, "transaction_ID not found");
      gw_err = VD_MSP_ERR_API;
      goto api_err_exit;
    }

    if (!qr_url->valuestring && !cJSON_IsString(qr_url)) {
      ESP_LOGE(TAG, "image_qrprom not found");
      gw_err = VD_MSP_ERR_API;
      goto api_err_exit;
    }

    gw->transaction_id = (char*)calloc(1, strlen(tx_id->valuestring) + 1);
    strcpy(gw->transaction_id, tx_id->valuestring);
    
    gw->qr_url = (char*)calloc(1, strlen(qr_url->valuestring) + 1);
    strcpy(gw->qr_url, qr_url->valuestring);

    gw->transaction_created = true;
  }

api_err_exit:

  cJSON_Delete(root);
  http_close(gw->http);
  gw->http = NULL;

  return gw_err;
}

// @note อย่าลืม free qr_png เอง และต้องเรียก vd_msp_promptpay_gateway_create_transaction ก่อนใช้งานฟังก์ชั่นนี้
vd_msp_err_t vd_msp_promptpay_gateway_get_qr(vd_msp_promptpay_gateway_t *gw, uint8_t **out_qr_png, size_t *out_size){
  if(!gw) return VD_MSP_ERR_INVALID_PARAM;
  if(!gw->transaction_created || !gw->qr_url) return VD_MSP_ERR_NODATA;

  vd_msp_err_t gw_err = VD_MSP_OK;

  gw->http = http_open(gw->qr_url, HTTP_METHOD_GET);
  if(!gw->http){
    ESP_LOGI(TAG, "Can't allocate memory for http");
    return VD_MSP_ERR_NO_MEM;
  }

  http_set_resp_opt(gw->http, false, true);
  uint8_t *data = (uint8_t*)http_send(gw->http);
  if(!data){
    ESP_LOGI(TAG, "Send request fail");
    gw_err = VD_MSP_ERR_HTTP;
    goto api_err_exit;
  }

  uint16_t http_code = http_get_code(gw->http);
  if(http_code != 200){
    ESP_LOGI(TAG, "API request fail, Code = %d", (int)http_code);
    gw_err = VD_MSP_ERR_API;
    goto api_err_exit;
  }

  size_t body_size = http_get_body_len(gw->http);
  uint8_t *buf = (uint8_t *)malloc(body_size);
  if (!buf) {
    http_close(gw->http);
    gw_err = VD_MSP_ERR_NO_MEM;
    goto api_err_exit;
  }

  memcpy(buf, data, body_size);
  *out_qr_png = buf;
  *out_size   = body_size;

api_err_exit:
  http_close(gw->http);
  gw->http = NULL;

  return gw_err;
}

vd_msp_err_t vd_msp_promptpay_gateway_get_payment_status(vd_msp_promptpay_gateway_t *gw, vd_msp_order_status_t *status){
  if(!gw || !strlen(gw->order_id)) return VD_MSP_ERR_INVALID_PARAM;
  if(!gw->transaction_created) return VD_MSP_ERR_NODATA;

  vd_msp_err_t gw_err = VD_MSP_OK;

  gw->http = http_open(VD_MSP_PRODUCTION_REDIRECT_SERVER_URL "CheckOrderID", HTTP_METHOD_POST);
  if(!gw->http){
    ESP_LOGI(TAG, "Can't allocate memory for http");
    return VD_MSP_ERR_NO_MEM;
  }

  cJSON *root = cJSON_CreateObject();
  cJSON_AddStringToObject(root, "secret_id", gw->secret_id);
  cJSON_AddStringToObject(root, "secret_key", gw->secret_key);
  cJSON_AddStringToObject(root, "order_id", gw->order_id);

  char *body = cJSON_PrintUnformatted(root);

  http_set_header(gw->http, "Content-Type", "application/json");
  http_set_body(gw->http, body);
  http_set_resp_opt(gw->http, false, true);
  
  const char *res = http_send(gw->http);
  if(!res){
    ESP_LOGI(TAG, "Send request fail");
    cJSON_Delete(root);
    free(body);
    http_close(gw->http);
    gw->http = NULL;

    return VD_MSP_ERR_HTTP;
  }

  uint16_t http_code = http_get_code(gw->http);
  if(http_code != 200){
    ESP_LOGI(TAG, "API request fail, Code = %d", (int)http_code);
    gw_err = VD_MSP_ERR_API;
    goto api_err_exit;
  }

  cJSON_Delete(root);

  root = cJSON_Parse(res);

  if (!cJSON_IsArray(root)) {
    ESP_LOGE(TAG, "Expected JSON Array at root");
    gw_err = VD_MSP_ERR_JSON;
    goto api_err_exit;
  }

  cJSON *item = cJSON_GetArrayItem(root, 0);
  if (!item || !cJSON_IsObject(item)) {
    ESP_LOGE(TAG, "Item[0] is not a valid JSON Object");
    gw_err = VD_MSP_ERR_JSON;
    goto api_err_exit;
  }

  // ถ้าไปเช็ก order ที่ยังไม่ได้ทำรายการ หรือหมดอายุไปนานแล้ว จะเข้ากรณีนี้
  cJSON *err_jstatus = cJSON_GetObjectItemCaseSensitive(item, "status");
  if(err_jstatus){
    ESP_LOGE(TAG, "status is a valid without order_id object, (this order not created!)");
    gw_err = VD_MSP_OK;
    *status = VD_MSP_ORDER_STATUS_ERROR;
    goto api_err_exit;
  }
  
  cJSON *order_id = cJSON_GetObjectItem(item, "order id");
  if(!order_id|| !cJSON_IsObject(order_id)){
      ESP_LOGE(TAG, "order id is not a valid JSON Object, (this order not created!)");
      gw_err = VD_MSP_ERR_JSON;
      goto api_err_exit;
    }

  cJSON *jstatus = cJSON_GetObjectItemCaseSensitive(order_id, "status");
  if(!jstatus){
    ESP_LOGE(TAG, "status invalid");
    gw_err = VD_MSP_ERR_API;
    goto api_err_exit;
  }

  if(strcmp(jstatus->valuestring, VD_MSP_ORDER_STATUS_ERROR_STR) == 0){
    ESP_LOGE(TAG, "status invalid");
    gw_err = VD_MSP_ERR_API;
    *status = VD_MSP_ORDER_STATUS_ERROR;
    goto api_err_exit;
  }

  if     (strcmp(jstatus->valuestring, VD_MSP_ORDER_STATUS_PENDING_STR) == 0) *status = VD_MSP_ORDER_STATUS_PENDING;
  else if(strcmp(jstatus->valuestring, VD_MSP_ORDER_STATUS_SUCCESS_STR) == 0) *status = VD_MSP_ORDER_STATUS_SUCCESS;
  else if(strcmp(jstatus->valuestring, VD_MSP_ORDER_STATUS_FAIL_STR)    == 0) *status = VD_MSP_ORDER_STATUS_FAIL;
  else if(strcmp(jstatus->valuestring, VD_MSP_ORDER_STATUS_CANCEL_STR)  == 0) *status = VD_MSP_ORDER_STATUS_CANCEL;
  else if(strcmp(jstatus->valuestring, VD_MSP_ORDER_STATUS_EXPIRED_STR) == 0) *status = VD_MSP_ORDER_STATUS_EXPIRED;

  cJSON *jamount = cJSON_GetObjectItemCaseSensitive(order_id, "amount");
  double amount_num = cjson_get_double(jamount, 0.0);
  if(!amount_num){
    ESP_LOGE(TAG, "amount invalid");
    gw_err = VD_MSP_ERR_API;
    *status = VD_MSP_ORDER_STATUS_ERROR;
    goto api_err_exit;
  }

  // if(amount_num != gw->amount) ...

api_err_exit:
  cJSON_Delete(root);
  http_close(gw->http);
  gw->http = NULL;

  return gw_err;
}

vd_msp_err_t vd_msp_promptpay_gateway_end_transaction(vd_msp_promptpay_gateway_t *gw){
  if(!gw) return VD_MSP_ERR_INVALID_PARAM;
  if(!gw->transaction_created) return VD_MSP_OK;

  gw->http                = NULL;
  gw->transaction_created = false;
  gw->amount              = 0.0;

  if(gw->transaction_id) free(gw->transaction_id);
  if(gw->qr_url)         free(gw->qr_url);

  memset(gw->order_id, '\0', sizeof(gw->order_id));

  return VD_MSP_OK;
}

static vd_msp_promptpay_gateway_t *s_gw = NULL;
static lv_obj_t *s_ta_amount = NULL;
static lv_obj_t *s_qr_img    = NULL;
static lv_obj_t *s_lbl_status = NULL;
static lv_obj_t *s_btn_pay   = NULL;

static lv_image_dsc_t s_dynamic_qr_dsc;
static uint8_t *s_downloaded_png = NULL;
static volatile bool s_polling_active = false;

static lv_obj_t *s_numpad = NULL;

/* Event เมื่อแตะช่องกรอกเงิน หรือเมื่อกดปิดคีย์บอร์ด */
static void _ta_amount_event_cb(lv_event_t *e) {
    lv_event_code_t code = lv_event_get_code(e);
    if (code == LV_EVENT_CLICKED || code == LV_EVENT_FOCUSED) {
        // แตะช่องกรอกเงิน -> แสดง Numpad ขึ้นมา
        if (s_numpad) {
            lv_keyboard_set_textarea(s_numpad, s_ta_amount);
            lv_obj_remove_flag(s_numpad, LV_OBJ_FLAG_HIDDEN);
            lv_obj_move_foreground(s_numpad);
        }
    }
}

static void _numpad_event_cb(lv_event_t *e) {
    lv_event_code_t code = lv_event_get_code(e);
    // เมื่อกดปุ่มติ๊กถูก (Ready) หรือปุ่มปิด (Cancel) ให้ซ่อน Numpad
    if (code == LV_EVENT_READY || code == LV_EVENT_CANCEL) {
        lv_obj_add_flag(s_numpad, LV_OBJ_FLAG_HIDDEN);
    }
}

/* เธรดเบื้องหลัง: สร้าง Transaction -> โหลดรูป QR -> Polling ทุกๆ 3 วินาที */
static void payment_worker_task(void *pvParam) {
    double amount = *(double *)pvParam;
    free(pvParam);

    // 1. สร้าง Order ID แบบไม่ซ้ำด้วย Timestamp
    char order_buf[32];
    snprintf(order_buf, sizeof(order_buf), "ORD%lld", (long long)(esp_timer_get_time() / 1000));

    vd_msp_promptpay_gateway_set_amount(s_gw, amount);
    vd_msp_promptpay_gateway_set_order_id(s_gw, order_buf);
    vd_msp_promptpay_gateway_set_device_id(s_gw, "ESP32P4_VEND_01");

    // อัปเดตสถานะบน UI
    if (lvgl_port_lock(portMAX_DELAY)) {
        lv_label_set_text(s_lbl_status, "สถานะ: กำลังสร้างรายการ QR...");
        lv_obj_set_style_text_color(s_lbl_status, lv_color_hex(0xEAB308), 0); // สีเหลือง
        lvgl_port_unlock();
    }

    // 2. เรียก API สร้าง Transaction
    vd_msp_err_t err = vd_msp_promptpay_gateway_create_transaction(s_gw);
    if (err != VD_MSP_OK) {
        if (lvgl_port_lock(portMAX_DELAY)) {
            lv_label_set_text_fmt(s_lbl_status, "สถานะ: สร้าง QR ไม่สำเร็จ (Err=%d)", err);
            lv_obj_set_style_text_color(s_lbl_status, lv_color_hex(0xEF4444), 0); // สีแดง
            lv_obj_clear_state(s_btn_pay, LV_STATE_DISABLED);
            lvgl_port_unlock();
        }
        vd_msp_promptpay_gateway_end_transaction(s_gw);
        vTaskDelete(NULL);
        return;
    }

    // 3. โหลดไฟล์ภาพ PNG ของ QR Code จาก MoneySpace
    uint8_t *png_raw = NULL;
    size_t png_size = 0;
    err = vd_msp_promptpay_gateway_get_qr(s_gw, &png_raw, &png_size);

    if (err == VD_MSP_OK && png_raw) {
        if (lvgl_port_lock(portMAX_DELAY)) {
            if (s_downloaded_png) free(s_downloaded_png);
            s_downloaded_png = png_raw;

            // เตรียม Descriptor สำหรับ Image Widget (LVGL RAW Format)
            s_dynamic_qr_dsc.header.magic = LV_IMAGE_HEADER_MAGIC;
            s_dynamic_qr_dsc.header.cf = LV_COLOR_FORMAT_RAW;
            s_dynamic_qr_dsc.header.w = 0;
            s_dynamic_qr_dsc.header.h = 0;
            s_dynamic_qr_dsc.data_size = png_size;
            s_dynamic_qr_dsc.data = s_downloaded_png;

            lv_image_set_src(s_qr_img, &s_dynamic_qr_dsc);
            lv_label_set_text(s_lbl_status, "สถานะ: รอการสแกนชำระเงิน...");
            lvgl_port_unlock();
        }
    }

    // 4. เริ่ม Polling ตรวจสอบยอดเงินทุกๆ 3 วินาที (วนรอบสูงสุด 60 ครั้ง = 3 นาที)
    s_polling_active = true;
    int retry_cnt = 0;

    while (s_polling_active && retry_cnt++ < 60) {
        vTaskDelay(pdMS_TO_TICKS(3000)); // หน่วงเวลา 3 วินาที

        vd_msp_order_status_t pay_st;
        vd_msp_err_t st_err = vd_msp_promptpay_gateway_get_payment_status(s_gw, &pay_st);

        if (st_err == VD_MSP_OK) {
            if (pay_st == VD_MSP_ORDER_STATUS_SUCCESS) {
                if (lvgl_port_lock(portMAX_DELAY)) {
                    lv_label_set_text(s_lbl_status, "สถานะ: ชำระเงินสำเร็จแล้ว! (Success)");
                    lv_obj_set_style_text_color(s_lbl_status, lv_color_hex(0x22C55E), 0); // สีเขียว
                    lv_obj_clear_state(s_btn_pay, LV_STATE_DISABLED);
                    lvgl_port_unlock();
                }
                break; // จบขั้นตอนการจ่ายเงิน
            } else if (pay_st == VD_MSP_ORDER_STATUS_EXPIRED || pay_st == VD_MSP_ORDER_STATUS_CANCEL) {
                if (lvgl_port_lock(portMAX_DELAY)) {
                    lv_label_set_text(s_lbl_status, "สถานะ: รายการหมดอายุหรือถูกยกเลิก");
                    lv_obj_set_style_text_color(s_lbl_status, lv_color_hex(0xEF4444), 0);
                    lv_obj_clear_state(s_btn_pay, LV_STATE_DISABLED);
                    lvgl_port_unlock();
                }
                break;
            }
        }
    }

    vd_msp_promptpay_gateway_end_transaction(s_gw);
    s_polling_active = false;
    vTaskDelete(NULL);
}

/* Event เมื่อแตะปุ่ม "สร้าง QR ชำระเงิน" */
static void _btn_create_qr_cb(lv_event_t *e) {
    if (s_polling_active) return;

    const char *amt_txt = lv_textarea_get_text(s_ta_amount);
    double amount = atof(amt_txt);
    if (amount <= 0.0) return;

    lv_obj_add_state(s_btn_pay, LV_STATE_DISABLED);

    double *p_amt = (double *)malloc(sizeof(double));
    *p_amt = amount;
    xTaskCreatePinnedToCore(payment_worker_task, "pay_task", 12 * 1024, p_amt, 10, NULL, 0);
}

/* Event ปุ่มลัดใส่จำนวนเงินสำเร็จรูป (10฿, 20฿, 50฿, 100฿) */
static void _btn_quick_amount_cb(lv_event_t *e) {
    const char *amt = (const char *)lv_event_get_user_data(e);
    lv_textarea_set_text(s_ta_amount, amt);
}

/* ฟังก์ชันสร้างหน้าจอ PromptPay UI แบบเรียบง่าย */
void create_simple_promptpay_ui(lv_obj_t *parent) {
    // กำหนด Keys เริ่มต้น
    if (!s_gw) {
        s_gw = vd_msp_promptpay_gateway_init("V5N0B0QSG31Z14S2FE62", 
                                            "3e68yE1E15zS33m1nyHPznh70e7vFq0yY853D0aGYbLJdMjup5GijQbQ5ZD9J0TJkVOIV9L40uW3XYiq", 
                                            "1");
    }

    // 1. กล่องการ์ดหน้าต่างชำระเงิน จัดกึ่งกลางจอ
    lv_obj_t *card = lv_obj_create(parent);
    lv_obj_set_size(card, 400, 560);
    lv_obj_center(card);
    lv_obj_set_style_bg_color(card, lv_color_hex(0x1E293B), 0);
    lv_obj_set_style_radius(card, 16, 0);
    lv_obj_set_style_pad_all(card, 12, 0);
    lv_obj_set_flex_flow(card, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(card, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    // 2. ชื่อหัวข้อ
    lv_obj_t *lbl_title = lv_label_create(card);
    lv_label_set_text(lbl_title, "ชำระเงินผ่าน PromptPay");
    lv_obj_set_style_text_color(lbl_title, lv_color_white(), 0);
    lv_obj_set_style_text_font(lbl_title, &anuphan_bold_18, 0);

    // 3. แถวระบุจำนวนเงิน (Label + TextArea)
    lv_obj_t *row_amt = lv_obj_create(card);
    lv_obj_set_size(row_amt, lv_pct(100), 50);
    lv_obj_set_style_bg_opa(row_amt, LV_OPA_TRANSP, 0);
    lv_obj_set_style_border_width(row_amt, 0, 0);
    lv_obj_set_style_pad_all(row_amt, 0, 0);
    lv_obj_set_flex_flow(row_amt, LV_FLEX_FLOW_ROW);
    lv_obj_set_flex_align(row_amt, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

    lv_obj_t *lbl_amt_tag = lv_label_create(row_amt);
    lv_label_set_text(lbl_amt_tag, "ยอดเงิน (บาท): ");
    lv_obj_set_style_text_color(lbl_amt_tag, lv_color_hex(0xCBD5E1), 0);
    lv_obj_set_style_text_font(lbl_amt_tag, &anuphan_16, 0);

    s_ta_amount = lv_textarea_create(row_amt);
    lv_obj_set_size(s_ta_amount, 130, 42);
    lv_textarea_set_text(s_ta_amount, "1.00");
    lv_textarea_set_one_line(s_ta_amount, true);
    lv_textarea_set_max_length(s_ta_amount, 8); // ป้องกันกรอกยาวเกิน
    lv_textarea_set_accepted_chars(s_ta_amount, "0123456789."); // รับเฉพาะตัวเลขและจุด
    lv_obj_set_style_text_font(s_ta_amount, &anuphan_16, 0);
    lv_obj_add_event_cb(s_ta_amount, _ta_amount_event_cb, LV_EVENT_ALL, NULL);

    s_numpad = lv_keyboard_create(parent);
    lv_keyboard_set_mode(s_numpad, LV_KEYBOARD_MODE_NUMBER); // ปรับเป็นปุ่มตัวเลขขนาดใหญ่
    lv_keyboard_set_textarea(s_numpad, s_ta_amount);
    lv_obj_set_size(s_numpad, 360, 220);
    lv_obj_align(s_numpad, LV_ALIGN_BOTTOM_MID, 0, -10);
    lv_obj_set_style_bg_color(s_numpad, lv_color_hex(0x0F172A), 0);
    lv_obj_set_style_radius(s_numpad, 12, 0);
    lv_obj_add_event_cb(s_numpad, _numpad_event_cb, LV_EVENT_ALL, NULL);
    lv_obj_add_flag(s_numpad, LV_OBJ_FLAG_HIDDEN); // ซ่อนไว้ตอนเริ่มต้น

    // 4. ปุ่มลัดเลือกราคาด่วน [1฿] [20฿] [50฿] [100฿]
    lv_obj_t *row_preset = lv_obj_create(card);
    lv_obj_set_size(row_preset, lv_pct(100), 40);
    lv_obj_set_style_bg_opa(row_preset, LV_OPA_TRANSP, 0);
    lv_obj_set_style_border_width(row_preset, 0, 0);
    lv_obj_set_style_pad_all(row_preset, 0, 0);
    lv_obj_set_flex_flow(row_preset, LV_FLEX_FLOW_ROW);
    lv_obj_set_flex_align(row_preset, LV_FLEX_ALIGN_SPACE_EVENLY, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

    const char *presets[] = {"1.00", "20.00", "50.00", "100.00"};
    for (int i = 0; i < 4; i++) {
        lv_obj_t *btn = lv_button_create(row_preset);
        lv_obj_set_size(btn, 65, 32);
        lv_obj_set_style_bg_color(btn, lv_color_hex(0x334155), 0);
        lv_obj_add_event_cb(btn, _btn_quick_amount_cb, LV_EVENT_CLICKED, (void *)presets[i]);

        lv_obj_t *lbl = lv_label_create(btn);
        lv_label_set_text_fmt(lbl, "%d฿", atoi(presets[i]));
        lv_obj_set_style_text_font(lbl, &anuphan_14, 0);
        lv_obj_center(lbl);
    }

    // 5. ปุ่มสั่งสร้าง QR Code
    s_btn_pay = lv_button_create(card);
    lv_obj_set_size(s_btn_pay, lv_pct(90), 44);
    lv_obj_set_style_bg_color(s_btn_pay, lv_color_hex(0x2563EB), 0);
    lv_obj_set_style_radius(s_btn_pay, 8, 0);
    lv_obj_add_event_cb(s_btn_pay, _btn_create_qr_cb, LV_EVENT_CLICKED, NULL);

    lv_obj_t *lbl_btn = lv_label_create(s_btn_pay);
    lv_label_set_text(lbl_btn, "สร้าง QR ชำระเงิน");
    lv_obj_set_style_text_font(lbl_btn, &anuphan_semi_bold_16, 0);
    lv_obj_center(lbl_btn);

    // 6. พื้นที่แสดง QR Code
    lv_obj_t *qr_box = lv_obj_create(card);
    lv_obj_set_size(qr_box, 290, 290);
    lv_obj_set_style_bg_color(qr_box, lv_color_white(), 0);
    lv_obj_set_style_radius(qr_box, 8, 0);
    lv_obj_set_style_pad_all(qr_box, 5, 0);
    lv_obj_set_scrollable(qr_box, false);

    s_qr_img = lv_image_create(qr_box);
    lv_obj_set_size(s_qr_img, 280, 280);
    lv_obj_center(s_qr_img);

    // 7. ข้อความแจ้งเตือนสถานะ
    s_lbl_status = lv_label_create(card);
    lv_label_set_text(s_lbl_status, "สถานะ: พร้อมทำรายการ");
    lv_obj_set_style_text_color(s_lbl_status, lv_color_hex(0x94A3B8), 0);
    lv_obj_set_style_text_font(s_lbl_status, &anuphan_14, 0);
}

static lv_obj_t *s_ta_manual_order  = NULL;
static lv_obj_t *s_lbl_manual_result = NULL;
static lv_obj_t *s_btn_manual_check  = NULL;
static lv_obj_t *s_kb_manual         = NULL;

/* Task สำหรับเรียกใช้ vd_msp_promptpay_gateway_get_payment_status โดยตรง */
/* Task ตรวจสอบสถานะ พร้อมดักจับ NULL Pointer ป้องกัน Crash */
static void manual_order_check_task(void *pvParam) {
    char *input_order_id = (char *)pvParam;

    // 1. ตรวจสอบและ Auto-Init หาก s_gw ยังเป็น NULL
    if (!s_gw) {
        s_gw = vd_msp_promptpay_gateway_init("V5N0B0QSG31Z14S2FE62", 
                                             "3e68yE1E15zS33m1nyHPznh70e7vFq0yY853D0aGYbLJdMjup5GijQbQ5ZD9J0TJkVOIV9L40uW3XYiq", 
                                             "1");
    }

    if (!s_gw) {
        ESP_LOGE(TAG, "Cannot init s_gw gateway structure!");
        if (lvgl_port_lock(portMAX_DELAY)) {
            lv_label_set_text(s_lbl_manual_result, "ผิดพลาด: Gateway ยังไม่ถูกเริ่มระบบ");
            lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0xEF4444), 0);
            lv_obj_clear_state(s_btn_manual_check, LV_STATE_DISABLED);
            lvgl_port_unlock();
        }
        free(input_order_id);
        vTaskDelete(NULL);
        return;
    }

    // อัปเดต UI แสดงว่ากำลังตรวจสอบ
    if (lvgl_port_lock(portMAX_DELAY)) {
        lv_label_set_text(s_lbl_manual_result, "กำลังตรวจสอบสถานะ...");
        lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0xEAB308), 0);
        lvgl_port_unlock();
    }

    // 2. ปลอดภัยแล้ว คัดลอก Order ID ลง struct
    strncpy(s_gw->order_id, input_order_id, sizeof(s_gw->order_id) - 1);
    s_gw->order_id[sizeof(s_gw->order_id) - 1] = '\0';
    s_gw->transaction_created = true; // ตั้งค่า true เพื่อให้ผ่านเงื่อนไขเช็คในฟังก์ชัน

    // 3. เรียกฟังก์ชันตรวจสอบสถานะของคุณโดยตรง
    vd_msp_order_status_t status = VD_MSP_ORDER_STATUS_ERROR;
    vd_msp_err_t err = vd_msp_promptpay_gateway_get_payment_status(s_gw, &status);

    // 4. แสดงผลลัพธ์ออกจอ
    if (lvgl_port_lock(portMAX_DELAY)) {
        if (err != VD_MSP_OK) {
            lv_label_set_text_fmt(s_lbl_manual_result, "ผิดพลาด: ตรวจสอบไม่สำเร็จ (Err Code: %d)", err);
            lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0xEF4444), 0);
        } else {
            switch (status) {
                case VD_MSP_ORDER_STATUS_SUCCESS:
                    lv_label_set_text(s_lbl_manual_result, "ผลลัพธ์: ชำระเงินสำเร็จ (Pay Success)");
                    lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0x22C55E), 0); // สีเขียว
                    break;
                case VD_MSP_ORDER_STATUS_PENDING:
                    lv_label_set_text(s_lbl_manual_result, "ผลลัพธ์: รอการชำระเงิน (Pending)");
                    lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0x38BDF8), 0); // สีฟ้า
                    break;
                case VD_MSP_ORDER_STATUS_FAIL:
                    lv_label_set_text(s_lbl_manual_result, "ผลลัพธ์: ทำรายการไม่สำเร็จ (Fail)");
                    lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0xEF4444), 0);
                    break;
                case VD_MSP_ORDER_STATUS_CANCEL:
                    lv_label_set_text(s_lbl_manual_result, "ผลลัพธ์: รายการถูกยกเลิก (Cancel)");
                    lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0xEF4444), 0);
                    break;
                case VD_MSP_ORDER_STATUS_EXPIRED:
                    lv_label_set_text(s_lbl_manual_result, "ผลลัพธ์: รายการหมดอายุ (Expired)");
                    lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0xEF4444), 0);
                    break;
                default:
                    lv_label_set_text(s_lbl_manual_result, "ผลลัพธ์: ไม่พบรายการหรือสถานะผิดพลาด");
                    lv_obj_set_style_text_color(s_lbl_manual_result, lv_color_hex(0xEF4444), 0);
                    break;
            }
        }

        lv_obj_clear_state(s_btn_manual_check, LV_STATE_DISABLED);
        lvgl_port_unlock();
    }

    free(input_order_id);
    vTaskDelete(NULL);
}

/* Callback เมื่อแตะปุ่ม "ตรวจสอบสถานะ" */
static void _btn_manual_check_cb(lv_event_t *e) {
    const char *text = lv_textarea_get_text(s_ta_manual_order);
    if (!text || strlen(text) == 0) return;

    lv_obj_add_state(s_btn_manual_check, LV_STATE_DISABLED);
    if (s_kb_manual) lv_obj_add_flag(s_kb_manual, LV_OBJ_FLAG_HIDDEN);

    char *order_copy = strdup(text);
    xTaskCreate(manual_order_check_task, "ord_chk_task", 12 * 1024, order_copy, 4, NULL);
}

/* Event ซ่อน/แสดง คีย์บอร์ดพิมพ์ข้อความ */
static void _ta_manual_event_cb(lv_event_t *e) {
    lv_event_code_t code = lv_event_get_code(e);
    if (code == LV_EVENT_CLICKED || code == LV_EVENT_FOCUSED) {
        if (s_kb_manual) {
            lv_keyboard_set_textarea(s_kb_manual, s_ta_manual_order);
            lv_obj_remove_flag(s_kb_manual, LV_OBJ_FLAG_HIDDEN);
            lv_obj_move_foreground(s_kb_manual);
        }
    }
}

static void _kb_manual_event_cb(lv_event_t *e) {
    lv_event_code_t code = lv_event_get_code(e);
    if (code == LV_EVENT_READY || code == LV_EVENT_CANCEL) {
        lv_obj_add_flag(s_kb_manual, LV_OBJ_FLAG_HIDDEN);
    }
}

