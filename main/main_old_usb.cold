/* เรียกเปิดหน้าเมื่อกด Sidebar */
void create_file_setting_page(vd_menu_content_t *content) {
  vd_file_browser_cbs_t fs_cbs = {
        .get_drives      = app_fs_get_drives,
        .list_dir        = app_fs_list_dir,
        .on_file_click   = app_fs_on_file_click,
        .on_new_folder   = app_fs_on_new_folder,

        // ★ ผูกเมนูกดค้างที่ลงทะเบียนไว้
        .actions         = s_app_file_actions,
        .action_count    = sizeof(s_app_file_actions) / sizeof(s_app_file_actions[0]),
        .on_action_click = app_on_action_click
    };

    vd_menu_page_files_create(content, &fs_cbs, NULL);
}

