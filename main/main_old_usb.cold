    vd_menu_sub_content_add_copyable_badge(card_status, "หมายเลข IP", "ใช้สำหรับเข้าถึงเครื่องจากระยะไกลในวงเครือข่ายเดียวกัน", "192.168.1.105", NULL, NULL);

