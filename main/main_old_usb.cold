    vd_menu_wifi_list_add_item(wifi_list, "HOME-NET-2.4G",   true,  false, 2, NULL, (void *)"HOME-NET-2.4G");
    vd_menu_wifi_list_add_item(wifi_list, "TP-LINK_5C2A",    true,  false, 2, NULL, (void *)"TP-LINK_5C2A");
    vd_menu_wifi_list_add_item(wifi_list, "FreeAirportWiFi", false, false, 1, NULL, (void *)"FreeAirportWiFi");

    // ── การ์ดที่ 3: สาย LAN (Ethernet) ──[cite: 15]
    vd_menu_sub_frame_t *card_lan = vd_menu_sub_frame_create(content, "สาย LAN (Ethernet)");
    const char *ip_modes[] = {"DHCP (อัตโนมัติ)", "กำหนดเอง"};
    vd_menu_sub_content_add_button_group(card_lan, "การกำหนดหมายเลข IP", "DHCP รับ IP อัตโนมัติจากเราเตอร์", ip_modes, 2, 0, NULL, NULL);
    vd_menu_sub_content_add_copyable_badge(card_lan, "ที่อยู่ MAC", "รหัสประจำการ์ดเครือข่ายของเครื่อง แก้ไขไม่ได้", "A4:CF:12:9B:E3:70", NULL, NULL);

    // ── การ์ดที่ 4: การใช้งานข้อมูลและการแจ้งเตือน ──[cite: 15]
    vd_menu_sub_frame_t *card_usage = vd_menu_sub_frame_create(content, "การใช้งานข้อมูลและการแจ้งเตือน");
    vd_menu_sub_content_add_switch(card_usage, "แจ้งเตือนเมื่อเครื่องออฟไลน์", "ส่งการแจ้งเตือนไปยังผู้ดูแลเมื่อขาดการเชื่อมต่อเกิน 5 นาที", true, NULL, NULL);
    vd_menu_sub_content_add_progress_bar(card_usage, "ข้อมูลที่ใช้ในเดือนนี้", "รอบนับวันที่ 1 ของทุกเดือน", 39, 100, "3.1 / 8.0 GB");
    vd_menu_sub_content_add_action_btn(card_usage, "เซิร์ฟเวอร์กลาง (Vending Cloud)", "ซิงค์ล่าสุด: 2 นาทีที่แล้ว", "\uf021", "ซิงค์ตอนนี้", NULL, NULL, NULL, NULL);
}

