/*!< endpoint address */
#define HID_INT_EP          0x81
#define HID_INT_EP_SIZE     4
#define HID_INT_EP_INTERVAL 1

#define USBD_VID           0xffff
#define USBD_PID           0xffff
#define USBD_MAX_POWER     100
#define USBD_LANGID_STRING 1033

/*!< config descriptor size */
#define USB_CONFIG_SIZE 34
/*!< report descriptor size */
#define HID_MOUSE_REPORT_DESC_SIZE 74

static const uint8_t device_descriptor[] = {
    USB_DEVICE_DESCRIPTOR_INIT(USB_2_0, 0x00, 0x00, 0x00, USBD_VID, USBD_PID, 0x0002, 0x01)
};

static const uint8_t config_descriptor[] = {
    USB_CONFIG_DESCRIPTOR_INIT(USB_CONFIG_SIZE, 0x01, 0x01, USB_CONFIG_BUS_POWERED, USBD_MAX_POWER),
    HID_MOUSE_DESCRIPTOR_INIT(0x00, 0x01, HID_MOUSE_REPORT_DESC_SIZE, HID_INT_EP, HID_INT_EP_SIZE, HID_INT_EP_INTERVAL),
};

static const uint8_t device_quality_descriptor[] = {
    ///////////////////////////////////////
    /// device qualifier descriptor
    ///////////////////////////////////////
    0x0a,
    USB_DESCRIPTOR_TYPE_DEVICE_QUALIFIER,
    0x00,
    0x02,
    0x00,
    0x00,
    0x00,
    0x40,
    0x00,
    0x00,
};

static const char *string_descriptors[] = {
    (const char[]){ 0x09, 0x04 }, /* Langid */
    "CherryUSB",                  /* Manufacturer */
    "CherryUSB HID DEMO",         /* Product */
    "2022123456",                 /* Serial Number */
};

static const uint8_t *device_descriptor_callback(uint8_t speed)
{
    return device_descriptor;
}

static const uint8_t *config_descriptor_callback(uint8_t speed)
{
    return config_descriptor;
}

static const uint8_t *device_quality_descriptor_callback(uint8_t speed)
{
    return device_quality_descriptor;
}

static const char *string_descriptor_callback(uint8_t speed, uint8_t index)
{
    if (index >= (sizeof(string_descriptors) / sizeof(char *))) {
        return NULL;
    }
    return string_descriptors[index];
}

const struct usb_descriptor hid_descriptor = {
    .device_descriptor_callback = device_descriptor_callback,
    .config_descriptor_callback = config_descriptor_callback,
    .device_quality_descriptor_callback = device_quality_descriptor_callback,
    .string_descriptor_callback = string_descriptor_callback
};

/*!< hid mouse report descriptor */
static const uint8_t hid_mouse_report_desc[HID_MOUSE_REPORT_DESC_SIZE] = {
    0x05, 0x01, // USAGE_PAGE (Generic Desktop)
    0x09, 0x02, // USAGE (Mouse)
    0xA1, 0x01, // COLLECTION (Application)
    0x09, 0x01, // USAGE (Pointer)
    0xA1, 0x00, // COLLECTION (Physical)
    0x05, 0x09, // USAGE_PAGE (Button)
    0x19, 0x01, // USAGE_MINIMUM (Button 1)
    0x29, 0x03, // USAGE_MAXIMUM (Button 3)
    0x15, 0x00, // LOGICAL_MINIMUM (0)
    0x25, 0x01, // LOGICAL_MAXIMUM (1)
    0x95, 0x03, // REPORT_COUNT (3)
    0x75, 0x01, // REPORT_SIZE (1)
    0x81, 0x02, // INPUT (Data,Var,Abs)
    0x95, 0x01, // REPORT_COUNT (1)
    0x75, 0x05, // REPORT_SIZE (5)
    0x81, 0x01, // INPUT (Cnst,Var,Abs)
    0x05, 0x01, // USAGE_PAGE (Generic Desktop)
    0x09, 0x30, // USAGE (X)
    0x09, 0x31, // USAGE (Y)
    0x09, 0x38, // Usage (Wheel)
    0x15, 0x81, // LOGICAL_MINIMUM (-127)
    0x25, 0x7F, // LOGICAL_MAXIMUM (127)
    0x75, 0x08, // REPORT_SIZE (8)
    0x95, 0x03, // REPORT_COUNT (2)
    0x81, 0x06, // INPUT (Data,Var,Rel)
    0xC0,       // END_COLLECTION
    0x09, 0x3c, // USAGE (Motion Wakeup)
    0x05, 0xff, // USAGE_PAGE (Vendor Defined 0xFF)
    0x09, 0x01, // USAGE (Vendor Usage 1)
    0x15, 0x00, // LOGICAL_MINIMUM (0)
    0x25, 0x01, // LOGICAL_MAXIMUM (1)
    0x75, 0x01, // REPORT_SIZE (1)
    0x95, 0x02, // REPORT_COUNT (2)
    0xb1, 0x22, // FEATURE (Data,Var,Abs,NPrf)
    0x75, 0x06, // REPORT_SIZE (6)
    0x95, 0x01, // REPORT_COUNT (1)
    0xb1, 0x01, // FEATURE (Cnst,Ary,Abs)
    0xc0        // END_COLLECTION
};

/*!< mouse report struct */
struct hid_mouse {
    uint8_t buttons;
    int8_t x;
    int8_t y;
    int8_t wheel;
};

/*!< mouse report */
static USB_NOCACHE_RAM_SECTION USB_MEM_ALIGNX struct hid_mouse mouse_cfg;

#define HID_STATE_IDLE 0
#define HID_STATE_BUSY 1

/*!< hid state ! Data can be sent only when state is idle  */
static volatile uint8_t hid_state = HID_STATE_IDLE;

static uint8_t _busid, _event, _usb_cb = false;

static void usbd_event_handler(uint8_t busid, uint8_t event)
{
  _busid = busid;
  _event = event;
  _usb_cb = true;
}

static volatile bool ep_tx_busy = false;

static void __my_usbd_event_handler(uint8_t busid, uint8_t event)
{
  _usb_cb = false;
    switch (event) {
        case USBD_EVENT_RESET:
          ESP_LOGI(TAG, "USB RESET");
            break;
        case USBD_EVENT_CONNECTED:
          ESP_LOGI(TAG, "USB CONNECTED");
            break;
        case USBD_EVENT_DISCONNECTED:
          ESP_LOGI(TAG, "USB DISCONNECTED");
            break;
        case USBD_EVENT_RESUME:
          ESP_LOGI(TAG, "USB RESUME");
            break;
        case USBD_EVENT_SUSPEND:  
          ESP_LOGI(TAG, "USB SUSPEND");
            break;
        case USBD_EVENT_CONFIGURED:
            hid_state = HID_STATE_IDLE;
            ep_tx_busy = false;
            ESP_LOGI(TAG, "USB CONFIGURED");
            break;
        case USBD_EVENT_SET_REMOTE_WAKEUP:
          ESP_LOGI(TAG, "USB SET_REMOTE_WAKEUP");
            break;
        case USBD_EVENT_CLR_REMOTE_WAKEUP:
          ESP_LOGI(TAG, "USB CLR_REMOTE_WAKEUP");
            break;

        default:
            break;
    }
}

/* function ------------------------------------------------------------------*/
static void usbd_hid_int_callback(uint8_t busid, uint8_t ep, uint32_t nbytes)
{
    hid_state = HID_STATE_IDLE;
    ep_tx_busy = false;
}

/*!< endpoint call back */
static struct usbd_endpoint hid_in_ep = {
    .ep_cb = usbd_hid_int_callback,
    .ep_addr = HID_INT_EP
};

struct usbd_interface intf0;

void hid_mouse_init(uint8_t busid, uintptr_t reg_base)
{
    usbd_desc_register(busid, &hid_descriptor);

    usbd_add_interface(busid, usbd_hid_init_intf(busid, &intf0, hid_mouse_report_desc, HID_MOUSE_REPORT_DESC_SIZE));
    usbd_add_endpoint(busid, &hid_in_ep);

    usbd_initialize(busid, reg_base, usbd_event_handler);

    /*!< init mouse report data */
    mouse_cfg.buttons = 0;
    mouse_cfg.wheel = 0;
    mouse_cfg.x = 0;
    mouse_cfg.y = 0;
}

void send_mouse_report(uint8_t buttons, int8_t x, int8_t y, int8_t wheel) {
    if (ep_tx_busy) return;

    // ใช้ mouse_cfg ที่มี Macro USB_MEM_ALIGNX ป้องกันปัญหา Cache และ DMA Alignment
    mouse_cfg.buttons = buttons;
    mouse_cfg.x = x;
    mouse_cfg.y = y;
    mouse_cfg.wheel = wheel;

    ep_tx_busy = true;
    usbd_ep_start_write(0, HID_INT_EP, (uint8_t *)&mouse_cfg, sizeof(mouse_cfg));
}

#include "diskio.h"
#include "usbh_core.h"
#include "usbh_msc.h"

static const char *TAG_USB = "USB_INFO";

static FATFS s_usb_fatfs;

void print_usb_drive_details(struct usbh_msc *msc_class, const char *drive_path);

static DSTATUS usb_init_cb(void *ctx) { return 0; }
static DSTATUS usb_status_cb(void *ctx) { return (ctx == NULL) ? STA_NOINIT : 0; }

#include "esp_memory_utils.h"

struct usb_drive_entry {
    FATFS fs;
    BYTE pdrv;
    struct usbh_msc *msc;
};

static struct usb_drive_entry s_usb_drives[2];

#define USB_DMA_ALIGN_SIZE 64
#define BOUNCE_BUF_SIZE    (16 * 1024) // 16 KB

// บัฟเฟอร์ 16 KB ใน Non-cache SRAM จัด Alignment 64 ไบต์
static USB_NOCACHE_RAM_SECTION USB_MEM_ALIGNX uint8_t s_dma_bounce_buf[BOUNCE_BUF_SIZE];

static DRESULT usb_read_cb(void *ctx, BYTE *buff, LBA_t sector, UINT count) {
    struct usbh_msc *msc = (struct usbh_msc *)ctx;
    if (!msc && s_usb_drives[0].msc) msc = s_usb_drives[0].msc;
    if (!msc) return RES_NOTRDY;

    uint32_t blk_size = msc->blocksize ? msc->blocksize : 512;

    // กรณีที่ 1: บัฟเฟอร์ต้องหาร 64 ลงตัว และอยู่ใน Internal DMA RAM เท่านั้น ถึงจะยิงรวดเดียว
    if (((uintptr_t)buff % USB_DMA_ALIGN_SIZE == 0) && esp_ptr_dma_capable(buff)) {
        int ret = usbh_msc_scsi_read10(msc, (uint32_t)sector, buff, count);
        return (ret == 0) ? RES_OK : RES_ERROR;
    }

    // กรณีที่ 2: บัฟเฟอร์ไม่ Align 64 (เช่น fs->win ของ FatFS) ให้ก๊อปปี้ผ่าน Bounce Buffer
    UINT sectors_left = count;
    LBA_t cur_sector = sector;
    BYTE *cur_buff = buff;
    UINT max_sectors = sizeof(s_dma_bounce_buf) / blk_size;

    while (sectors_left > 0) {
        UINT chunk = (sectors_left > max_sectors) ? max_sectors : sectors_left;
        int ret = usbh_msc_scsi_read10(msc, (uint32_t)cur_sector, s_dma_bounce_buf, chunk);
        if (ret != 0) {
            ESP_LOGE(TAG_USB, "SCSI Read10 failed at LBA: %lu", (unsigned long)cur_sector);
            return RES_ERROR;
        }
        memcpy(cur_buff, s_dma_bounce_buf, chunk * blk_size);

        cur_sector += chunk;
        cur_buff += (chunk * blk_size);
        sectors_left -= chunk;
    }

    return RES_OK;
}

static uint32_t s_wr_calls, s_wr_sectors, s_wr_bounce, s_rd_calls, s_rd_sectors, s_rd_bounce;
static uint64_t s_wr_us, s_rd_us;
static uint32_t s_hist[8];   /* count: 1, 2-3, 4-7, 8-15, 16-31, 32-63, 64-127, 128+ */

static DRESULT usb_write_cb(void *ctx, const BYTE *buff, LBA_t sector, UINT count) {
  /* ในต้น usb_write_cb */
int64_t t0 = esp_timer_get_time();
s_wr_calls++; s_wr_sectors += count;
int b = 31 - __builtin_clz(count | 1); if (b > 7) b = 7; s_hist[b]++;
/* ... ก่อน return ทุกทาง */
s_wr_us += esp_timer_get_time() - t0;

    struct usbh_msc *msc = (struct usbh_msc *)ctx;
    if (!msc && s_usb_drives[0].msc) msc = s_usb_drives[0].msc;
    if (!msc) return RES_NOTRDY;

    uint32_t blk_size = msc->blocksize ? msc->blocksize : 512;

    // กรณีที่ 1: บัฟเฟอร์ต้องหาร 64 ลงตัว และอยู่ใน Internal DMA RAM เท่านั้น ถึงจะยิงรวดเดียว
    if (((uintptr_t)buff % USB_DMA_ALIGN_SIZE == 0) && esp_ptr_dma_capable(buff)) {
        int ret = usbh_msc_scsi_write10(msc, (uint32_t)sector, buff, count);
        return (ret == 0) ? RES_OK : RES_ERROR;
    }

    // กรณีที่ 2: บัฟเฟอร์ไม่ Align 64 ให้ก๊อปปี้ผ่าน Bounce Buffer
    UINT sectors_left = count;
    LBA_t cur_sector = sector;
    const BYTE *cur_buff = buff;
    UINT max_sectors = sizeof(s_dma_bounce_buf) / blk_size;

    while (sectors_left > 0) {
        UINT chunk = (sectors_left > max_sectors) ? max_sectors : sectors_left;
        memcpy(s_dma_bounce_buf, cur_buff, chunk * blk_size);
        int ret = usbh_msc_scsi_write10(msc, (uint32_t)cur_sector, s_dma_bounce_buf, chunk);
        if (ret != 0) {
            ESP_LOGE(TAG_USB, "SCSI Write10 failed at LBA: %lu", (unsigned long)cur_sector);
            return RES_ERROR;
        }

        cur_sector += chunk;
        cur_buff += (chunk * blk_size);
        sectors_left -= chunk;
    }

    return RES_OK;
}

static DRESULT usb_ioctl_cb(void *ctx, BYTE cmd, void *buff) {
    struct usbh_msc *msc = (struct usbh_msc *)ctx;
    if (!msc) return RES_NOTRDY;

    switch (cmd) {
        case CTRL_SYNC: 
            return RES_OK;
        case GET_SECTOR_COUNT: 
            *(LBA_t *)buff = (LBA_t)msc->blocknum; 
            return RES_OK;
        case GET_SECTOR_SIZE: 
            *(WORD *)buff = (WORD)(msc->blocksize ? msc->blocksize : 512); 
            return RES_OK;
        case GET_BLOCK_SIZE: 
            *(DWORD *)buff = 1; 
            return RES_OK;
        default: 
            return RES_PARERR;
    }
}

static const diskio_ops_t s_usb_ops = {
    .init = usb_init_cb,
    .status = usb_status_cb,
    .read = usb_read_cb,
    .write = usb_write_cb,
    .ioctl = usb_ioctl_cb,
};

static const char *TAG_BENCH = "USB_BENCH";

/**
 * @brief ฟังก์ชันทดสอบความเร็วการอ่าน-เขียน USB Drive ผ่าน FatFS
 * @param drive_path ไดรฟ์ที่ต้องการทดสอบ เช่น "0:" หรือ "1:"
 * @param total_size_mb ขนาดไฟล์รวมที่ใช้ทดสอบ (MB) แนะนำ 8 - 16 MB
 * @param chunk_size_kb ขนาดบัฟเฟอร์ต่อรอบการเขียน (KB) แนะนำ 32 หรือ 64 KB
 */
void usb_storage_benchmark(const char *drive_path, uint32_t total_size_mb, uint32_t chunk_size_kb) {
    char file_path[32];
    snprintf(file_path, sizeof(file_path), "%s/bench_test.tmp", drive_path);

    size_t chunk_bytes = chunk_size_kb * 1024;
    size_t total_bytes = total_size_mb * 1024 * 1024;
    uint32_t total_chunks = total_bytes / chunk_bytes;

    ESP_LOGI(TAG_BENCH, "==================================================");
    ESP_LOGI(TAG_BENCH, "Starting USB Storage Benchmark on [%s]", file_path);
    ESP_LOGI(TAG_BENCH, "Total Size: %lu MB | Chunk Size: %lu KB (%lu Blocks)", 
             (unsigned long)total_size_mb, (unsigned long)chunk_size_kb, (unsigned long)total_chunks);
    ESP_LOGI(TAG_BENCH, "==================================================");

    // จองบัฟเฟอร์ใน Internal SRAM ที่รองรับ DMA และ Align 4 ไบต์
    uint8_t *buf = (uint8_t *)heap_caps_aligned_alloc(64, chunk_bytes, MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
    if (!buf) {
        ESP_LOGE(TAG_BENCH, "Cannot allocate %lu KB DMA buffer!", (unsigned long)chunk_size_kb);
        return;
    }

    // เติมข้อมูล Pattern ลงบัฟเฟอร์เพื่อกันการบีบอัดข้อมูลหลอก
    for (size_t i = 0; i < chunk_bytes; i++) {
        buf[i] = (uint8_t)(i & 0xFF);
    }

    FIL file;
    FRESULT fr;
    UINT bw = 0, br = 0;

    /* -----------------------------------------------------------
     * 1. ทดสอบการเขียน (Write Benchmark)
     * ----------------------------------------------------------- */
    ESP_LOGI(TAG_BENCH, "Running Write Test...");
    fr = f_open(&file, file_path, FA_CREATE_ALWAYS | FA_WRITE);
    if (fr != FR_OK) {
        ESP_LOGE(TAG_BENCH, "f_open for write failed (Error: %d)", fr);
        free(buf);
        return;
    }

    int64_t t_write_start = esp_timer_get_time();

    for (uint32_t i = 0; i < total_chunks; i++) {
        fr = f_write(&file, buf, chunk_bytes, &bw);
        if (fr != FR_OK || bw != chunk_bytes) {
            ESP_LOGE(TAG_BENCH, "Write failed at chunk %lu (Error: %d, written: %u)", (unsigned long)i, fr, bw);
            f_close(&file);
            free(buf);
            return;
        }
    }

    // ต้องรวมจังหวะ flush ข้อมูลและปิดไฟล์เข้าไปด้วย เพื่อให้ได้เวลาที่เขียนลง NAND Flash จริง
    f_close(&file);
    int64_t t_write_end = esp_timer_get_time();

    double write_time_sec = (double)(t_write_end - t_write_start) / 1000000.0;
    double write_speed_mbs = ((double)total_bytes / (1024.0 * 1024.0)) / write_time_sec;

    ESP_LOGI(TAG_BENCH, ">> Write Finished: %lu MB in %.3f sec", (unsigned long)total_size_mb, write_time_sec);
    ESP_LOGI(TAG_BENCH, ">> Write Speed   : %.2f MB/s", write_speed_mbs);

    /* -----------------------------------------------------------
     * 2. ทดสอบการอ่าน (Read Benchmark)
     * ----------------------------------------------------------- */
    ESP_LOGI(TAG_BENCH, "Running Read Test...");
    fr = f_open(&file, file_path, FA_READ);
    if (fr != FR_OK) {
        ESP_LOGE(TAG_BENCH, "f_open for read failed (Error: %d)", fr);
        free(buf);
        return;
    }

    int64_t t_read_start = esp_timer_get_time();

    for (uint32_t i = 0; i < total_chunks; i++) {
        fr = f_read(&file, buf, chunk_bytes, &br);
        if (fr != FR_OK || br != chunk_bytes) {
            ESP_LOGE(TAG_BENCH, "Read failed at chunk %lu (Error: %d, read: %u)", (unsigned long)i, fr, br);
            f_close(&file);
            free(buf);
            return;
        }
    }

    f_close(&file);
    int64_t t_read_end = esp_timer_get_time();

    double read_time_sec = (double)(t_read_end - t_read_start) / 1000000.0;
    double read_speed_mbs = ((double)total_bytes / (1024.0 * 1024.0)) / read_time_sec;

    ESP_LOGI(TAG_BENCH, ">> Read Finished : %lu MB in %.3f sec", (unsigned long)total_size_mb, read_time_sec);
    ESP_LOGI(TAG_BENCH, ">> Read Speed    : %.2f MB/s", read_speed_mbs);

    /* -----------------------------------------------------------
     * 3. ล้างไฟล์ทดสอบทิ้ง (Cleanup)
     * ----------------------------------------------------------- */
    f_unlink(file_path);
    free(buf);

    ESP_LOGI(TAG_BENCH, "==================================================");
    ESP_LOGI(TAG_BENCH, "Benchmark Completed Successfully");
    ESP_LOGI(TAG_BENCH, "==================================================");

    ESP_LOGI(TAG_BENCH, "WR calls=%lu sectors=%lu avg=%.1f sec/call bounce=%lu time=%.2fs",
         s_wr_calls, s_wr_sectors, (double)s_wr_sectors/s_wr_calls, s_wr_bounce, s_wr_us/1e6);
ESP_LOGI(TAG_BENCH, "hist 1:%lu 2:%lu 4:%lu 8:%lu 16:%lu 32:%lu 64:%lu 128+:%lu",
         s_hist[0],s_hist[1],s_hist[2],s_hist[3],s_hist[4],s_hist[5],s_hist[6],s_hist[7]);
}

void usbh_msc_run(struct usbh_msc *msc_class) {
    if (!msc_class) return;

    // 1. เรียกใช้ API ตัวจริงของ CherryUSB เพื่อเริ่มระบบ SCSI และดึงขนาดความจุ
    int ret = usbh_msc_scsi_init(msc_class);
    if (ret != 0) {
        ESP_LOGE(TAG_USB, "usbh_msc_scsi_init failed (ret=%d)", ret);
        return;
    }

    ESP_LOGI(TAG_USB, "SCSI Ready: Total Blocks = %lu, Sector Size = %u Bytes",
             (unsigned long)msc_class->blocknum, msc_class->blocksize);

    // 2. หา Slot ว่าง
    int slot_idx = -1;
    for (int i = 0; i < 2; i++) {
        if (s_usb_drives[i].msc == NULL) {
            slot_idx = i;
            break;
        }
    }

    if (slot_idx < 0) {
        ESP_LOGE(TAG_USB, "No free drive slot available!");
        return;
    }

    // 3. ลงทะเบียนเข้า diskio
    BYTE pdrv = 0;
    if (diskio_register_driver(&s_usb_ops, msc_class, &pdrv) != RES_OK) {
        ESP_LOGE(TAG_USB, "Disk slot full! Cannot register USB Drive");
        return;
    }

    s_usb_drives[slot_idx].msc  = msc_class;
    s_usb_drives[slot_idx].pdrv = pdrv;

    char drive_path[8];
    snprintf(drive_path, sizeof(drive_path), "%u:", pdrv);

    // 4. สั่ง Mount เข้า FatFS
    FRESULT fr = f_mount(&s_usb_drives[slot_idx].fs, drive_path, 1);
    if (fr == FR_OK) {
        ESP_LOGI(TAG_USB, "Mount successful on %s", drive_path);
        print_usb_drive_details(msc_class, drive_path);

        // ทดสอบเขียน-อ่านไฟล์ขนาด 8 MB โดยส่งข้อมูลรอบละ 64 KB
        usb_storage_benchmark(drive_path, 16, 64);
    } else {
        ESP_LOGE(TAG_USB, "Mount failed on %s (Error code: %d)", drive_path, fr);
        f_mount(NULL, drive_path, 0);
        diskio_unregister_driver(pdrv);
        s_usb_drives[slot_idx].msc = NULL;
    }
}

void usbh_msc_stop(struct usbh_msc *msc_class) {
    for (int i = 0; i < 2; i++) {
        if (s_usb_drives[i].msc == msc_class) {
            char drive_path[8];
            snprintf(drive_path, sizeof(drive_path), "%u:", s_usb_drives[i].pdrv);

            f_mount(NULL, drive_path, 0);                 // Unmount ออกจาก FatFS
            diskio_unregister_driver(s_usb_drives[i].pdrv); // คืน Slot ใน diskio

            printf("USB Drive removed from pdrv: %u\n", s_usb_drives[i].pdrv);
            s_usb_drives[i].msc = NULL;
            break;
        }
    }
}

// แปลงความเร็ว USB เป็นข้อความ
static const char *get_usb_speed_str(uint8_t speed) {
    switch (speed) {
        case USB_SPEED_LOW:  return "Low Speed (1.5 Mbps)";
        case USB_SPEED_FULL: return "Full Speed (12 Mbps)";
        case USB_SPEED_HIGH: return "High Speed (480 Mbps)";
        default:             return "Unknown";
    }
}

// แปลงชนิดระบบไฟล์ของ FatFS เป็นข้อความ
static const char *get_fs_type_str(BYTE fs_type) {
    switch (fs_type) {
        case FS_FAT12: return "FAT12";
        case FS_FAT16: return "FAT16";
        case FS_FAT32: return "FAT32";
        case FS_EXFAT: return "exFAT";
        default:       return "Unknown/RAW";
    }
}

void print_usb_drive_details(struct usbh_msc *msc_class, const char *drive_path) {
    if (!msc_class) return;

    ESP_LOGI(TAG_USB, "==================================================");
    ESP_LOGI(TAG_USB, "           USB DRIVE SPECIFICATION REPORT         ");
    ESP_LOGI(TAG_USB, "==================================================");

    /* -----------------------------------------------------------
     * 1. ข้อมูลระดับ USB Controller & Device Descriptor (CherryUSB)
     * ----------------------------------------------------------- */
    struct usbh_hubport *hport = msc_class->hport;
    if (hport) {
        ESP_LOGI(TAG_USB, "[USB Hardware]");
        ESP_LOGI(TAG_USB, "  - Connection Speed : %s", get_usb_speed_str(hport->speed));
        ESP_LOGI(TAG_USB, "  - Device Address   : %d", hport->dev_addr);
        ESP_LOGI(TAG_USB, "  - Vendor ID (VID)  : 0x%04X", hport->device_desc.idVendor);
        ESP_LOGI(TAG_USB, "  - Product ID (PID) : 0x%04X", hport->device_desc.idProduct);
        ESP_LOGI(TAG_USB, "  - USB Version      : %X.%02X", 
                 hport->device_desc.bcdUSB >> 8, hport->device_desc.bcdUSB & 0xFF);
    }

    /* -----------------------------------------------------------
     * 2. ข้อมูลระดับ Block Device / SCSI Layer (CherryUSB)
     * ----------------------------------------------------------- */
    uint32_t block_size = msc_class->blocksize;
    uint64_t total_blocks = msc_class->blocknum;
    uint64_t raw_capacity_bytes = total_blocks * (uint64_t)block_size;
    double raw_capacity_gb = (double)raw_capacity_bytes / (1024.0 * 1024.0 * 1024.0);

    ESP_LOGI(TAG_USB, "[SCSI Block Storage]");
    ESP_LOGI(TAG_USB, "  - Sector/Block Size: %lu Bytes", (unsigned long)block_size);
    ESP_LOGI(TAG_USB, "  - Total Sectors    : %llu", (unsigned long long)total_blocks);
    ESP_LOGI(TAG_USB, "  - Raw Disk Size    : %.2f GB (%llu MB)", 
             raw_capacity_gb, (unsigned long long)(raw_capacity_bytes / (1024 * 1024)));

    /* -----------------------------------------------------------
     * 3. ข้อมูลระดับ Filesystem (FatFS)
     * ----------------------------------------------------------- */
    FATFS *fs = NULL;
    DWORD free_clusters = 0;

    // หาขนาดพื้นที่ว่างและเข้าถึงข้อมูลโครงสร้าง FATFS
    FRESULT fr = f_getfree(drive_path, &free_clusters, &fs);

    if (fr == FR_OK && fs != NULL) {
        // อ่าน Volume Label และ Serial Number

        #if FF_USE_LABEL
        char label[34] = {0};
        DWORD vsn = 0;
        f_getlabel(drive_path, label, &vsn);
        #endif

        // คำนวณความจุตามโครงสร้าง Cluster ของระบบไฟล์
        // 1 Cluster = csize * sector_size
        uint64_t total_sectors_fs = (uint64_t)(fs->n_fatent - 2) * fs->csize;
        uint64_t free_sectors_fs  = (uint64_t)free_clusters * fs->csize;

        uint64_t total_fs_bytes = total_sectors_fs * block_size;
        uint64_t free_fs_bytes  = free_sectors_fs * block_size;
        uint64_t used_fs_bytes  = total_fs_bytes - free_fs_bytes;

        ESP_LOGI(TAG_USB, "[Filesystem (%s)]", drive_path);
        ESP_LOGI(TAG_USB, "  - Format Type      : %s", get_fs_type_str(fs->fs_type));
        //ESP_LOGI(TAG_USB, "  - Volume Label     : %s", strlen(label) > 0 ? label : "[NO NAME]");
        //ESP_LOGI(TAG_USB, "  - Volume Serial No : 0x%08lX", (unsigned long)vsn);
        ESP_LOGI(TAG_USB, "  - Cluster Size     : %lu Bytes (%u Sectors)", 
                 (unsigned long)(fs->csize * block_size), fs->csize);
        ESP_LOGI(TAG_USB, "  - Total Volume Size: %.2f GB", (double)total_fs_bytes / (1024.0 * 1024.0 * 1024.0));
        ESP_LOGI(TAG_USB, "  - Used Space       : %.2f GB (%.1f%%)", 
                 (double)used_fs_bytes / (1024.0 * 1024.0 * 1024.0),
                 total_fs_bytes > 0 ? ((double)used_fs_bytes / total_fs_bytes) * 100.0 : 0.0);
        ESP_LOGI(TAG_USB, "  - Free Space       : %.2f GB", (double)free_fs_bytes / (1024.0 * 1024.0 * 1024.0));
    } else {
        ESP_LOGW(TAG_USB, "[Filesystem]");
        ESP_LOGW(TAG_USB, "  - Could not read filesystem (f_getfree error: %d)", fr);
        ESP_LOGW(TAG_USB, "  - Flash Drive อาจยังไม่ได้เมานต์ หรือเป็นฟอร์แมตที่ FatFS ไม่รองรับ");
    }

    ESP_LOGI(TAG_USB, "==================================================");
}

static const char *TAG_USBH = "USBH_INIT";

static void usb(void *p){
 /*
     * usbh_initialize(busid, reg_base)
     * - busid: 0 (Bus หมายเลข 0)
     * - reg_base: Base address ของคอนโทรลเลอร์ Synopsys DWC2
     */
    int ret = usbh_initialize(0, (uintptr_t)ESP_USB_HS0_BASE, NULL);
    if (ret != 0) {
        ESP_LOGE(TAG_USBH, "usbh_initialize failed! (Error: %d)", ret);
        vTaskDelete(NULL);
        return;
    }

    ESP_LOGI(TAG_USBH, "USB Host ready! Waiting for devices...");

    // CherryUSB Host ใช้ระบบ Interrupt และมี Hub Task ภายในคอยจัดการ
    // Task นี้สามารถปล่อยให้ Sleep เพื่อประหยัด CPU ได้
    while (1) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}

